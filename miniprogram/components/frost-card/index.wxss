.frost-card {
  background: rgba(20, 20, 20, 0.8);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(212, 176, 131, 0.2);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.frost-card.small {
  padding: 24rpx;
}

.frost-card.medium {
  padding: 32rpx;
}

.frost-card.large {
  padding: 40rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(212, 176, 131, 0.2);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
  line-height: 1.2;
}

.card-header-right {
  display: flex;
  align-items: center;
}

.card-content {
  min-height: 80rpx;
}

.card-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(212, 176, 131, 0.2);
  display: flex;
  justify-content: flex-end;
  align-items: center;
}