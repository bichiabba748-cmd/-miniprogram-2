.service-container { 
   min-height: 100vh; 
   background: #0a0a0a; 
   padding: 32rpx; 
   box-sizing: border-box; 
 } 
 
 .page-title { 
   font-size: 48rpx; 
   font-weight: bold; 
   color: #D4B083; 
   text-align: center; 
   margin-bottom: 40rpx; 
   font-family: 'DIN Alternate', sans-serif; 
 } 
 
 /* 服务卡片 */ 
 .service-card { 
   background: rgba(212, 176, 131, 0.05); 
   backdrop-filter: blur(10px); 
   border: 1px solid rgba(212, 176, 131, 0.2); 
   border-radius: 24rpx; 
   padding: 32rpx; 
   margin-bottom: 32rpx; 
 } 
 
 .service-header { 
   display: flex; 
   align-items: center; 
   gap: 16rpx; 
   margin-bottom: 32rpx; 
   padding-bottom: 24rpx; 
   border-bottom: 1px solid rgba(212, 176, 131, 0.15); 
 } 
 
 .service-icon { 
   font-size: 48rpx; 
 } 
 
 .service-name { 
   font-size: 40rpx; 
   font-weight: bold; 
   color: #D4B083; 
 } 
 
 /* 服务信息 */ 
 .service-info { 
   display: flex; 
   flex-direction: column; 
   gap: 24rpx; 
 } 
 
 .info-row { 
   display: flex; 
   flex-direction: column; 
   gap: 12rpx; 
 } 
 
 .info-label { 
   font-size: 28rpx; 
   color: rgba(255, 255, 255, 0.6); 
 } 
 
 .info-value { 
   font-size: 30rpx; 
   color: #ffffff; 
   line-height: 1.5; 
 } 
 
 /* 电话行 */ 
 .phone-row { 
   flex-direction: row; 
   align-items: center; 
   justify-content: space-between; 
 } 
 
 .phone-box { 
   display: flex; 
   align-items: center; 
   gap: 16rpx; 
   background: rgba(10, 10, 10, 0.4); 
   padding: 16rpx 24rpx; 
   border-radius: 12rpx; 
   border: 1px solid rgba(212, 176, 131, 0.1); 
 } 
 
 .phone-number { 
   font-size: 32rpx; 
   font-weight: bold; 
   color: #ffffff; 
   font-family: 'DIN Alternate', sans-serif; 
 } 
 
 .phone-btn { 
   font-size: 26rpx; 
   color: #0a0a0a; 
   background: linear-gradient(135deg, #D4B083 0%, #A8864B 100%); 
   padding: 8rpx 20rpx; 
   border-radius: 8rpx; 
   font-weight: bold; 
 } 
 
 /* 价格列表 */ 
 .price-list { 
   display: flex; 
   flex-direction: column; 
   gap: 12rpx; 
   background: rgba(10, 10, 10, 0.3); 
   padding: 20rpx; 
   border-radius: 12rpx; 
 } 
 
 .price-item { 
   font-size: 28rpx; 
   color: rgba(255, 255, 255, 0.8); 
   line-height: 1.5; 
 } 
 
 /* 服务提示 */ 
 .service-tip { 
   display: flex; 
   align-items: center; 
   gap: 12rpx; 
   background: rgba(212, 176, 131, 0.1); 
   padding: 16rpx 20rpx; 
   border-radius: 12rpx; 
   margin-top: 8rpx; 
 } 
 
 .tip-icon { 
   font-size: 32rpx; 
   flex-shrink: 0; 
 } 
 
 .tip-text { 
   font-size: 26rpx; 
   color: #D4B083; 
   line-height: 1.5; 
 } 
 
 /* 免责声明 */ 
 .disclaimer-card { 
   background: rgba(212, 176, 131, 0.08); 
   backdrop-filter: blur(10px); 
   border: 1px solid rgba(212, 176, 131, 0.25); 
   border-radius: 24rpx; 
   padding: 32rpx; 
   margin-top: 40rpx; 
 } 
 
 .disclaimer-header { 
   display: flex; 
   align-items: center; 
   gap: 12rpx; 
   margin-bottom: 24rpx; 
 } 
 
 .disclaimer-icon { 
   font-size: 40rpx; 
 } 
 
 .disclaimer-title { 
   font-size: 32rpx; 
   font-weight: bold; 
   color: #D4B083; 
 } 
 
 .disclaimer-content { 
   display: flex; 
   flex-direction: column; 
   gap: 16rpx; 
 } 
 
 .disclaimer-text { 
  font-size: 28rpx; 
  color: rgba(255, 255, 255, 0.75); 
  line-height: 1.6; 
}

/* 图标组件 */
.icon-key::before {
  content: '🔑';
}

.icon-broom::before {
  content: '🧹';
}

.icon-truck::before {
  content: '🚚';
}

.icon-furniture::before {
  content: '🛋️';
}

.icon-warning::before {
  content: '⚠️';
}

.service-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.disclaimer-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}