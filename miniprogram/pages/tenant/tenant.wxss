.tenant-container {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 20rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顾问卡片 */ 
.agent-card {
  background: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
  border: 1rpx solid #222;
}

.agent-avatar { 
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 50%; 
  margin-right: 20rpx; 
}

.agent-info { 
  flex: 1; 
}

.agent-name { 
  display: block; 
  font-size: 32rpx; 
  font-weight: 600; 
  color: #ffffff; 
  margin-bottom: 8rpx; 
}

.agent-phone { 
  display: block; 
  font-size: 28rpx; 
  color: #cccccc; 
}

.contact-btns {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-call,
.btn-wechat {
  width: 160rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  padding: 0;
  margin: 0;
  font-weight: 500;
}

.btn-call {
  background: #D4B083;
  color: #0a0a0a;
  border: none;
}

.btn-wechat {
  background: rgba(212, 176, 131, 0.1);
  color: #D4B083;
  border: 1rpx solid #D4B083;
}

/* 登录引导 */
.login-guide {
  background: #111111;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.8);
  min-height: 300rpx;
  border: 1rpx solid #222;
}

.btn-login {
  width: 400rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #D4B083;
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 176, 131, 0.5);
}

/* 核心宫格 */ 
.tenant-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
  flex: 1;
}

.grid-item {
  background: #111111;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
  border: 1rpx solid #222;
  transition: all 0.3s;
  min-height: 200rpx;
}

.gi-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #D4B083;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 40rpx;
}

.gi-icon-box .iconfont {
  font-size: 48rpx;
  color: #0a0a0a;
  font-weight: normal;
}

.gi-icon-box .icon-emoji {
  font-size: 48rpx;
  line-height: 1;
}

/* 图标组件 */
.icon-lock::before {
  content: '🔒';
}

.icon-house::before {
  content: '🏠';
}

.icon-calendar::before {
  content: '📅';
}

.icon-money::before {
  content: '💰';
}

.icon-user::before {
  content: '👤';
}

.icon-refresh::before {
  content: '🔄';
}

.icon-building::before {
  content: '🏢';
}

.icon-phone::before {
  content: '📞';
}

.icon-document::before {
  content: '📄';
}

.icon-wifi::before {
  content: '📡';
}

.icon-wrench::before {
  content: '🔧';
}

.icon-shopping::before {
  content: '🛒';
}

.gi-name {
  font-size: 26rpx;
  color: #ffffff;
  text-align: center;
  font-weight: 600;
}

.gi-preview {
  font-size: 20rpx;
  color: #cccccc;
  text-align: center;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 底部广告Banner - 精美大图 */ 
.ad-banner { 
  background: #111111; 
  backdrop-filter: blur(20rpx); 
  border-radius: 24rpx; 
  padding: 40rpx; 
  margin: 32rpx 0; 
  border: 1rpx solid #222; 
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.8); 
  position: relative; 
  overflow: hidden; 
}

.ad-banner::before { 
  content: ''; 
  position: absolute; 
  top: -50%; 
  right: -50%; 
  width: 200%; 
  height: 200%; 
  background: radial-gradient(circle, rgba(212, 176, 131, 0.1) 0%, transparent 70%); 
  animation: pulse 3s infinite; 
}

@keyframes pulse { 
  0%, 100% { opacity: 0.5; } 
  50% { opacity: 1; } 
}

.ad-content { 
  display: flex; 
  align-items: center; 
  position: relative; 
  z-index: 1; 
}

.ad-icon { 
  font-size: 64rpx; 
  margin-right: 24rpx; 
}

.ad-text { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
  gap: 8rpx; 
}

.ad-title { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #ffffff; 
  line-height: 1.4; 
}

.ad-desc { 
  font-size: 26rpx; 
  color: rgba(255, 255, 255, 0.7); 
}

.ad-arrow { 
  font-size: 48rpx; 
  color: #D4B083; 
  font-weight: bold; 
}

/* 应急联系区 */ 
.emergency-contact { 
  background: #111111; 
  backdrop-filter: blur(20rpx); 
  border-radius: 24rpx; 
  padding: 32rpx; 
  margin-bottom: 32rpx; 
  border: 1rpx solid #222; 
}

.emergency-title { 
  display: block; 
  font-size: 28rpx; 
  color: rgba(255, 255, 255, 0.6); 
  margin-bottom: 24rpx; 
  text-align: center; 
}

.emergency-row { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  padding: 24rpx; 
  background: #1a1a1a; 
  border-radius: 16rpx; 
  margin-bottom: 16rpx; 
  border: 1rpx solid #333; 
}

.emergency-row:last-child { 
  margin-bottom: 0; 
}

.emergency-label { 
  font-size: 28rpx; 
  color: #ffffff; 
}

.emergency-phone { 
  font-size: 30rpx; 
  color: #D4B083; 
  font-family: 'DIN Alternate', sans-serif; 
  font-weight: bold; 
}

/* 合同大卡片 - 黑金渐变版 */
.contract-card {
  background: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.8);
  position: relative;
  overflow: hidden;
  border: 1rpx solid #222;
}

.contract-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(212, 176, 131, 0.1), transparent);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.contract-header {
  margin-bottom: 24rpx;
}

.contract-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #D4B083;
}

.contract-body {
  margin-bottom: 24rpx;
}

.contract-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.contract-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #cccccc;
}

.value {
  font-size: 28rpx;
  color: #ffffff;
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.value-highlight {
  font-size: 32rpx;
  color: #D4B083;
  font-weight: 600;
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

/* 续租按钮 */
.btn-renew {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #D4B083;
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 176, 131, 0.5);
  position: relative;
  overflow: hidden;
  border: none;
}

.btn-renew::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

/* 租房数据看板 */
.stats-board {
  background: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
  border: 1rpx solid #222;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #cccccc;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(212, 176, 131, 0.3);
}
