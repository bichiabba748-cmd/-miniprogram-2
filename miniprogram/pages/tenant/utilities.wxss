.utilities-container { 
   min-height: 100vh; 
   background: #0a0a0a; 
   padding: 32rpx; 
   box-sizing: border-box; 
 } 
 
 .page-title { 
   font-size: 48rpx; 
   font-weight: bold; 
   color: #D4B083; 
   text-align: center; 
   margin-bottom: 40rpx; 
   font-family: 'DIN Alternate', sans-serif; 
 } 
 
 /* 缴费卡片 */ 
 .utility-card { 
   background: rgba(212, 176, 131, 0.05); 
   backdrop-filter: blur(10px); 
   border: 1px solid rgba(212, 176, 131, 0.2); 
   border-radius: 24rpx; 
   padding: 32rpx; 
   margin-bottom: 32rpx; 
 } 
 
 .util-header { 
   display: flex; 
   align-items: center; 
   gap: 16rpx; 
   margin-bottom: 32rpx; 
   padding-bottom: 24rpx; 
   border-bottom: 1px solid rgba(212, 176, 131, 0.15); 
 } 
 
 .util-icon { 
   font-size: 48rpx; 
 } 
 
 .util-name { 
   font-size: 40rpx; 
   font-weight: bold; 
   color: #D4B083; 
   flex: 1; 
 } 
 
 .season-tag { 
   font-size: 24rpx; 
   color: #D4B083; 
   background: rgba(212, 176, 131, 0.15); 
   padding: 8rpx 16rpx; 
   border-radius: 8rpx; 
 } 
 
 /* 户号板块 */ 
 .account-section { 
   margin-bottom: 32rpx; 
 } 
 
 .account-label { 
   display: block; 
   font-size: 28rpx; 
   color: rgba(255, 255, 255, 0.6); 
   margin-bottom: 16rpx; 
 } 
 
 .account-box { 
   display: flex; 
   align-items: center; 
   justify-content: space-between; 
   background: rgba(10, 10, 10, 0.4); 
   padding: 24rpx; 
   border-radius: 16rpx; 
   border: 1px solid rgba(212, 176, 131, 0.1); 
 } 
 
 .account-number { 
   font-size: 36rpx; 
   font-weight: bold; 
   color: #ffffff; 
   font-family: 'DIN Alternate', sans-serif; 
 } 
 
 .copy-btn { 
   background: linear-gradient(135deg, #D4B083 0%, #A8864B 100%); 
   padding: 12rpx 24rpx; 
   border-radius: 12rpx; 
 } 
 
 .copy-text { 
   font-size: 26rpx; 
   color: #0a0a0a; 
   font-weight: bold; 
 } 
 
 /* 缴费方式 */ 
 .method-section { 
   display: flex; 
   flex-direction: column; 
   gap: 24rpx; 
 } 
 
 .method-title { 
   font-size: 32rpx; 
   font-weight: bold; 
   color: #ffffff; 
 } 
 
 .method-item { 
   background: rgba(10, 10, 10, 0.3); 
   padding: 24rpx; 
   border-radius: 16rpx; 
   border: 1px solid rgba(212, 176, 131, 0.08); 
 } 
 
 .method-name { 
   display: block; 
   font-size: 30rpx; 
   font-weight: bold; 
   color: #D4B083; 
   margin-bottom: 16rpx; 
 } 
 
 .method-steps { 
   display: flex; 
   flex-direction: column; 
   gap: 12rpx; 
 } 
 
 .method-step { 
   font-size: 26rpx; 
   color: rgba(255, 255, 255, 0.75); 
   line-height: 1.5; 
   padding-left: 8rpx; 
 } 
 
 .method-note { 
   font-size: 26rpx; 
   color: rgba(255, 255, 255, 0.75); 
   line-height: 1.5; 
 } 
 
 .util-tip { 
   display: flex; 
   align-items: center; 
   gap: 12rpx; 
   background: rgba(212, 176, 131, 0.1); 
   padding: 16rpx 20rpx; 
   border-radius: 12rpx; 
   margin-top: 8rpx; 
 } 
 
 .tip-icon { 
   font-size: 32rpx; 
 } 
 
 .tip-text { 
   font-size: 26rpx; 
   color: #D4B083; 
 } 
 
 /* 暖气费特殊信息 */ 
 .heating-info { 
   display: flex; 
   flex-direction: column; 
   gap: 12rpx; 
   margin-top: 12rpx; 
 } 
 
 .info-item { 
   font-size: 26rpx; 
   color: rgba(255, 255, 255, 0.75); 
   line-height: 1.5; 
 } 
 
 /* 小贴士卡片 */ 
 .tips-card { 
   background: rgba(212, 176, 131, 0.08); 
   backdrop-filter: blur(10px); 
   border: 1px solid rgba(212, 176, 131, 0.25); 
   border-radius: 24rpx; 
   padding: 32rpx; 
   margin-top: 40rpx; 
 } 
 
 .tips-header { 
   display: flex; 
   align-items: center; 
   gap: 12rpx; 
   margin-bottom: 24rpx; 
 } 
 
 .tips-icon { 
   font-size: 40rpx; 
 } 
 
 .tips-title { 
   font-size: 32rpx; 
   font-weight: bold; 
   color: #D4B083; 
 } 
 
 .tips-list { 
   display: flex; 
   flex-direction: column; 
   gap: 16rpx; 
 } 
 
 .tip-item { 
  font-size: 28rpx; 
  color: rgba(255, 255, 255, 0.8); 
  line-height: 1.6; 
}

/* 图标组件 */
.icon-fire::before {
  content: '🔥';
}

.icon-water::before {
  content: '💧';
}

.icon-thermometer::before {
  content: '🌡️';
}

.icon-warning::before {
  content: '⚠️';
}

.icon-money::before {
  content: '💰';
}

.icon-lightbulb::before {
  content: '💡';
}

.icon-lightning::before {
  content: '⚡';
}