.property-page {
  min-height: 100vh;
  background: #0a0a0a;
  padding-top: 88rpx;
  padding-bottom: 40rpx;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #d4af37;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.page-content {
  padding: 0 32rpx;
}

.section {
  background: linear-gradient(135deg, #1a1a1a 0%, #2d3436 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.section-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-icon {
  font-size: 48rpx;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #d4af37 50%, transparent 100%);
  margin: 24rpx 0;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #d4af37;
  margin-bottom: 16rpx;
}

.phone-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.phone-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  flex: 1;
}

.btn-dial {
  width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #d4af37 0%, #f4d477 100%);
  color: #0a0a0a;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
  padding: 0;
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.4);
}

.hours-text {
  font-size: 28rpx;
  color: #cccccc;
  line-height: 1.6;
}

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.payment-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(212, 175, 55, 0.05);
  border-radius: 12rpx;
}

.payment-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: linear-gradient(135deg, #d4af37 0%, #f4d477 100%);
  color: #0a0a0a;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  flex-shrink: 0;
}

.payment-desc {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.4;
}

.fee-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(212, 175, 55, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #d4af37;
  line-height: 1.5;
}

/* 图标组件 */
.icon-location::before {
  content: '📍';
}

.icon-phone::before {
  content: '📞';
}

.icon-clock::before {
  content: '🕐';
}

.icon-money::before {
  content: '💰';
}

.icon-lightbulb::before {
  content: '💡';
}

.brand-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}