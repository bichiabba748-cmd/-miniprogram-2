.contract-page { 
  min-height: 100vh; 
  background: #0a0a0a; 
  padding: 32rpx; 
  padding-bottom: 120rpx; 
} 

/* 房源信息卡片 */ 
.house-card { 
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); 
  border-radius: 16rpx; 
  padding: 32rpx; 
  margin-bottom: 24rpx; 
} 

.card-header { 
  display: flex; 
  align-items: center; 
  margin-bottom: 24rpx; 
} 

.house-icon { 
  font-size: 48rpx; 
  margin-right: 16rpx; 
} 

.house-info { 
  display: flex; 
  flex-direction: column; 
} 

.house-addr { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #ffffff; 
  margin-bottom: 8rpx; 
} 

.house-size { 
  font-size: 24rpx; 
  color: #999999; 
} 

.card-body { 
  display: flex; 
  flex-direction: column; 
  gap: 16rpx; 
} 

.info-row { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
} 

.label { 
  font-size: 28rpx; 
  color: #999999; 
} 

.value { 
  font-size: 28rpx; 
  color: #ffffff; 
  font-weight: bold; 
} 

/* 租住数据卡片 */ 
.data-card { 
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); 
  border-radius: 16rpx; 
  padding: 32rpx; 
  margin-bottom: 24rpx; 
} 

.card-title { 
  font-size: 28rpx; 
  color: #D4B083; 
  margin-bottom: 20rpx; 
  display: block; 
} 

.data-row { 
  display: flex; 
  justify-content: space-around; 
  margin-bottom: 16rpx; 
} 

.data-item { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
} 

.data-value { 
  font-size: 48rpx; 
  font-weight: bold; 
  color: #D4B083; 
  margin-bottom: 8rpx; 
} 

.data-label { 
  font-size: 24rpx; 
  color: #999999; 
} 

.data-total { 
  text-align: center; 
  padding-top: 16rpx; 
  border-top: 1rpx solid #333333; 
} 

.data-total text { 
  font-size: 28rpx; 
  color: #ffffff; 
} 

/* 联系人卡片 */ 
.contact-card { 
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); 
  border-radius: 16rpx; 
  padding: 32rpx; 
  margin-bottom: 24rpx; 
} 

.contact-info { 
  display: flex; 
  flex-direction: column; 
  margin: 16rpx 0; 
} 

.contact-name { 
  font-size: 28rpx; 
  color: #ffffff; 
  margin-bottom: 8rpx; 
} 

.contact-phone { 
  font-size: 28rpx; 
  color: #999999; 
} 

.btn-call { 
  background: #2a2a2a; 
  color: #D4B083; 
  border: 1rpx solid #D4B083; 
  border-radius: 8rpx; 
  font-size: 28rpx; 
  padding: 16rpx; 
} 

/* 续租按钮 */ 
.renew-section { 
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  padding: 20rpx 32rpx; 
  background: #0a0a0a; 
  border-top: 1rpx solid #333333; 
} 

.btn-renew { 
  width: 100%; 
  background: #D4B083; 
  color: #0a0a0a; 
  font-size: 32rpx; 
  font-weight: bold; 
  border-radius: 8rpx; 
  padding: 24rpx; 
  border: none; 
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.card-title-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

/* 图标组件 */
.icon-house::before {
  content: '🏠';
}

.icon-calendar::before {
  content: '📅';
}

.icon-money::before {
  content: '💰';
}

.icon-key::before {
  content: '🔑';
}
