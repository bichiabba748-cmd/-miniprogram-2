page {
  background-color: #0a0a0a;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* 样式切换器 */
.style-switcher {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #111;
  border-radius: 20rpx;
  border: 1rpx solid #222;
}

.switcher-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4B083;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 1rpx;
}

.style-list {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.style-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.style-item.active {
  border-color: #D4B083;
  background: rgba(212, 176, 131, 0.1);
}

.style-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.style-name {
  font-size: 20rpx;
  color: #D4B083;
  font-weight: bold;
}

/* 顶部英雄区 - 招聘宣传 */
.hero-section {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
  border-radius: 20rpx;
  border: 1rpx solid #333;
  position: relative;
  overflow: hidden;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #D4B083, transparent);
}

.hero-section::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(212, 176, 131, 0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
  pointer-events: none;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.hero-badge {
  display: inline-block;
  background: linear-gradient(135deg, #D4B083 0%, #C09A6B 100%);
  color: #000;
  font-size: 20rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #D4B083 0%, #F4D03F 25%, #D4B083 50%, #F4D03F 75%, #D4B083 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 2rpx;
  animation: shimmer 3s linear infinite;
  text-shadow: 0 0 20rpx rgba(212, 176, 131, 0.3);
}

@keyframes shimmer {
  0% {
    background-position: 0% center;
  }
  100% {
    background-position: 200% center;
  }
}

.hero-subtitle {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  display: block;
  background: rgba(212, 176, 131, 0.05);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(212, 176, 131, 0.1);
  display: inline-block;
  margin-top: 20rpx;
}

/* 核心优势 */
.advantage-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
