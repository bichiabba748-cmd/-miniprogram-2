.data-role {
  font-size: 24rpx;
  color: #888;
  display: block;
}

.data-stats-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #111;
  border-radius: 20rpx;
  border: 1rpx solid #222;
}

.data-stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4B083;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 1rpx;
}

.data-stats-grid {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.data-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.data-stat-item:hover {
  border-color: #D4B083;
  background: rgba(212, 176, 131, 0.05);
}

.data-stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #D4B083;
  margin-bottom: 8rpx;
}

.data-stat-value.gold {
  color: #FFD700;
}

.data-stat-label {
  font-size: 20rpx;
  color: #888;
}

.data-code-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #111;
  border-radius: 20rpx;
  border: 1rpx solid #222;
}

.data-code-label {
  font-size: 24rpx;
  color: #D4B083;
  margin-bottom: 16rpx;
  display: block;
}

.data-code-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1a1a1a;
  border: 2rpx solid #D4B083;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 16rpx;
}

.data-code {
  font-size: 48rpx;
  font-weight: bold;
  color: #D4B083;
  font-family: 'Courier New', monospace;
  letter-spacing: 6rpx;
}

.data-copy-btn {
  background: linear-gradient(135deg, #D4B083 0%, #C09A6B 100%);
  color: #000;
  font-size: 24rpx;
  font-weight: bold;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.data-copy-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(212, 176, 131, 0.3);
}

.data-share-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #111;
  border-radius: 20rpx;
  border: 1rpx solid #222;
}

.data-share-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
}

.data-share-btn:hover {
  border-color: #D4B083;
  background: rgba(212, 176, 131, 0.05);
  transform: translateY(-2rpx);
}

.data-footer {
  text-align: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
  border-radius: 20rpx;
  border: 1rpx solid #333;
}

.data-footer text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}