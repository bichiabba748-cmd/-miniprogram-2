/* 税费计算器 - 黑金主题 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a1a1a 100%);
  padding: 24rpx;
  padding-bottom: 48rpx;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #D4B083;
  font-weight: bold;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4B083;
  font-family: 'DIN Condensed Bold', sans-serif;
}

.placeholder {
  width: 64rpx;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4B083;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(212, 176, 131, 0.2);
}

/* 输入区 */
.input-section {
  margin-bottom: 24rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(212, 176, 131, 0.3);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: rgba(255, 255, 255, 0.4);
  font-size: 28rpx;
}

/* 选项区 */
.options-section {
  margin-bottom: 32rpx;
}

.option-group {
  margin-bottom: 28rpx;
}

.option-group:last-child {
  margin-bottom: 0;
}

.option-label {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(212, 176, 131, 0.3);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.2s;
  text-align: center;
  line-height: 1.4;
  white-space: pre-line;
}

.option-item.active {
  background: #D4B083;
  border-color: #D4B083;
  color: #0a0a0a;
  font-weight: bold;
}

/* 操作按钮区 */
.action-section {
  margin: 40rpx 32rpx;
}

.action-section gold-button {
  display: block;
  width: 100%;
}

.action-section .gold-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #D4B083 0%, #C4A070 100%);
  box-shadow: 0 8rpx 24rpx rgba(212, 176, 131, 0.35);
  transition: all 0.3s ease;
  text-align: center;
  line-height: 1;
}

.action-section .gold-button.disabled {
  background: #2a2a2a !important;
  color: #666 !important;
  box-shadow: none !important;
  border: 2rpx solid #444;
}

.action-section .gold-button:not(.disabled):active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(212, 176, 131, 0.25);
}

.reset-btn {
  text-align: center;
  margin-top: 32rpx;
  padding: 16rpx;
}

.reset-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  text-decoration: underline;
}

/* 结果区 */
.result-section {
  margin-top: 8rpx;
}

.result-item {
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-item:last-of-type {
  border-bottom: none;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.result-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-name {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

.info-icon {
  font-size: 28rpx;
  color: #D4B083;
  opacity: 0.7;
  padding: 4rpx;
}

.info-icon:active {
  opacity: 1;
}

.result-value {
  font-size: 36rpx;
  color: #D4B083;
  font-weight: bold;
  font-family: 'DIN Condensed Bold', sans-serif;
}

.result-value.exempt {
  color: #4ade80;
}

.result-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-rate {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.exempt-text {
  font-size: 24rpx;
  color: #4ade80;
}

/* 新政红利标签 */
.bonus-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(212, 176, 131, 0.15);
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.bonus-icon {
  font-size: 28rpx;
}

.bonus-text {
  font-size: 24rpx;
  color: #D4B083;
  font-weight: 500;
}

/* 个税计算方式 */
.tax-method {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.method-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.method-toggle {
  font-size: 24rpx;
  color: #D4B083;
  text-decoration: underline;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #D4B083 50%, transparent 100%);
  margin: 24rpx 0;
}

/* 合计区 */
.total-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.total-label {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.total-value {
  font-size: 48rpx;
  color: #D4B083;
  font-weight: bold;
  font-family: 'DIN Condensed Bold', sans-serif;
}

/* 错误提示 */
.error-toast {
  position: fixed;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(239, 68, 68, 0.9);
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  z-index: 1000;
}

.error-text {
  font-size: 28rpx;
  color: #ffffff;
}
