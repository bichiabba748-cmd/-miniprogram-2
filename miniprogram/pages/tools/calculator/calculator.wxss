/* 黑金主题 - 房贷计算器 */
page {
  background: #000;
  color: #fff;
}

.container {
  padding: 20rpx 30rpx 40rpx;
}

/* 贷款类型 Tab */
.loan-type-tabs {
  display: flex;
  background: #111;
  border-radius: 8rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #888;
  border-radius: 6rpx;
}

.tab.active {
  background: #D4B083;
  color: #000;
  font-weight: 500;
}

/* 表单区域 */
.form-section {
  background: #111;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 12rpx;
}

.input {
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #fff;
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  line-height: 40rpx;
}

.rate-input-wrap {
  display: flex;
  align-items: center;
}

.rate-input {
  flex: 1;
}

.rate-hint {
  font-size: 24rpx;
  color: #D4B083;
  margin-left: 20rpx;
  white-space: nowrap;
}

/* Picker 样式 */
.picker {
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  box-sizing: border-box;
}

.picker-text {
  font-size: 30rpx;
  color: #fff;
}

/* 利率选择器样式 */
.rate-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rate-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4B083;
  min-width: 100rpx;
}

.rate-label {
  font-size: 26rpx;
  color: #888;
  flex: 1;
}

.picker-arrow {
  font-size: 28rpx;
  color: #666;
}

/* 还款方式 Tab */
.repayment-tabs {
  display: flex;
  gap: 16rpx;
}

.repayment-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.repayment-tab.active {
  background: rgba(212, 176, 131, 0.15);
  border-color: #D4B083;
  color: #D4B083;
}

/* 计算按钮 */
.calc-btn-wrap {
  margin: 30rpx 0;
}

.calc-btn {
  width: 100%;
  background: #D4B083;
  color: #000;
  font-size: 32rpx;
  font-weight: 500;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 8rpx;
  border: none;
  padding: 0;
}

.calc-btn::after {
  border: none;
}

.calc-btn.loading {
  background: #666;
  color: #999;
}

/* 结果区域 */
.result-section {
  margin-top: 30rpx;
}

.result-card {
  background: #111;
  border: 1rpx solid #222;
  border-radius: 12rpx;
  padding: 30rpx;
}

.result-title {
  font-size: 26rpx;
  color: #D4B083;
  text-align: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #222;
}

.result-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-item {
  flex: 1;
  text-align: center;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.result-value {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

/* 智能分析条 */
.analysis-bar {
  background: rgba(212, 176, 131, 0.1);
  border: 1rpx solid rgba(212, 176, 131, 0.3);
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.analysis-text {
  flex: 1;
  font-size: 26rpx;
  color: #D4B083;
}

.analysis-arrow {
  font-size: 28rpx;
  color: #D4B083;
  margin-left: 10rpx;
}

/* 利率选择器 */
.rate-selector {
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  box-sizing: border-box;
}

.rate-selector .rate-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4B083;
  min-width: 100rpx;
}

.rate-selector .rate-label {
  font-size: 26rpx;
  color: #888;
  flex: 1;
}

.rate-selector .rate-arrow {
  font-size: 28rpx;
  color: #666;
}

/* 利率选择弹窗 */
.rate-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #111;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  max-height: 70vh;
}

.rate-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 2rpx solid #222;
}

.rate-modal-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.rate-modal-close {
  font-size: 48rpx;
  color: #666;
  padding: 0 10rpx;
}

.rate-modal-body {
  padding: 20rpx 30rpx 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.rate-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  margin-bottom: 16rpx;
  background: #1a1a1a;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.rate-option.active {
  background: rgba(212, 176, 131, 0.15);
  border-color: #D4B083;
}

.rate-option-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #D4B083;
}

.rate-option-label {
  font-size: 28rpx;
  color: #888;
  margin-left: 20rpx;
}

.rate-option-check {
  font-size: 36rpx;
  color: #D4B083;
  position: absolute;
  right: 30rpx;
}

/* 错误提示 */
.error-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.9);
  color: #ff4444;
  padding: 24rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  z-index: 1000;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #111;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  max-height: 70vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #222;
}

.modal-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.modal-close {
  font-size: 40rpx;
  color: #666;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

/* 对照表 */
.comparison-table {
  background: #1a1a1a;
  border-radius: 8rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: #222;
  padding: 20rpx 0;
}

.th {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #888;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #222;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.highlight {
  background: rgba(212, 176, 131, 0.05);
}

.td {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
}

.td.label {
  color: #888;
}

.comparison-tip {
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(212, 176, 131, 0.1);
  border-radius: 8rpx;
}

.comparison-tip text {
  font-size: 24rpx;
  color: #D4B083;
  line-height: 1.5;
}
