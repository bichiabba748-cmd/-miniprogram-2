.container {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.date {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #D4B083;
  font-family: 'DIN Condensed', sans-serif;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tabs {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tab-item.active {
  background: linear-gradient(135deg, #D4B083 0%, #E8D4B8 100%);
}

.tab-item.active text {
  color: #0a0a0a;
  font-weight: bold;
}

.content-area {
  margin-bottom: 32rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: rgba(255, 255, 255, 0.6);
}

.content-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  overflow: hidden;
  backdrop-filter: blur(20rpx);
}

.image-container {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.text-container {
  padding: 32rpx;
}

.text-content {
  font-size: 32rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  white-space: pre-wrap;
}

.action-bar {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #D4B083 0%, #E8D4B8 100%);
  color: #0a0a0a;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #D4B083;
  border: 2rpx solid #D4B083;
}

.btn::after {
  border: none;
}

.refresh-btn {
  text-align: center;
  padding: 24rpx 0;
  color: #D4B083;
  font-size: 28rpx;
}

.tip {
  text-align: center;
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tip text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}