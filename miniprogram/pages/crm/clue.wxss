page { 
  background: #000000; 
  color: #ffffff; 
  font-family: 'DIN', sans-serif; 
}

.container {
  padding: 40rpx 40rpx 180rpx; /* 底部留出按钮空间 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* 输入组通用样式 */
.input-group {
  margin-bottom: 60rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.required {
  color: #D4B083;
  margin-left: 8rpx;
}

/* 大号输入框 */
.big-input {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  border-bottom: 1rpx solid #333;
  padding: 20rpx 0;
  height: 80rpx;
}

.ph {
  color: #333;
  font-weight: normal;
}

/* 标签矩阵 */
.tag-matrix {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.tag {
  padding: 16rpx 36rpx;
  background: #1a1a1a;
  color: #888;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #333;
  transition: all 0.2s;
}

.tag.active {
  background: rgba(212, 176, 131, 0.15);
  color: #D4B083;
  border-color: #D4B083;
  font-weight: bold;
}

/* 星级评分 */
.star-row {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.star-icon {
  font-size: 60rpx;
  color: #222; /* 未选中颜色 */
  transition: color 0.2s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.star-icon.active {
  color: #D4B083;
  text-shadow: 0 0 15rpx rgba(212, 176, 131, 0.4);
}

/* 图标组件 */
.icon-star::before {
  content: '★';
}

.icon-sparkle::before {
  content: '✨';
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  margin-right: 8rpx;
}

.star-desc {
  font-size: 22rpx;
  color: #555;
}

/* 备注区域 */
.remark-area {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.6;
  color: #fff;
  background: #111;
  padding: 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid #222;
  box-sizing: border-box;
  min-height: 200rpx;
}

/* 底部按钮区 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx 40rpx 60rpx;
  background: linear-gradient(to top, #000 90%, rgba(0,0,0,0));
  z-index: 100;
  box-sizing: border-box;
}

.submit-btn {
  height: 100rpx;
  background: #D4B083;
  color: #000;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(212, 176, 131, 0.3);
  letter-spacing: 4rpx;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}