<view class="container" wx:if="{{client.id}}">
  
  <view class="header-card">
    <view class="h-top">
      <text class="h-name">{{client.name}}</text>
      <view class="h-tag {{client.status === 'deal' ? 'deal' : ''}}">
        {{client.status === 'deal' ? '已成交' : '跟进中'}}
      </view>
      <view class="more-btn" bindtap="openActionSheet">•••</view>
    </view>
    
    <view class="h-stars">
      <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
        <view class="star-icon {{item <= client.level ? 'active' : ''}} icon-star-full"></view>
      </block>
      <text class="level-text">{{levelDesc[client.level]}}</text>
    </view>

    <view class="data-grid">
      <view class="grid-item">
        <text class="g-label">联系电话</text>
        <text class="g-val phone" bindtap="onCall">{{client.phone}}</text>
      </view>
      <view class="grid-item">
        <text class="g-label">线索来源</text>
        <text class="g-val">{{client.source}}</text>
      </view>
      <view class="grid-item" wx:if="{{isBroker}}">
        <text class="g-label">保护期</text>
        <text class="g-val warn">剩 {{client.daysLeft}} 天</text>
      </view>
      <view class="grid-item" wx:if="{{isAnchor}}">
        <text class="g-label">跟进人</text>
        <text class="g-val gold">{{client.brokerName}}</text>
      </view>
    </view>
  </view>

  <view class="timeline-box">
    <view class="section-title">跟进记录</view>
    <view class="timeline">
      <block wx:for="{{followList}}" wx:key="id">
        <view class="node">
          <view class="node-dot active"></view>
          <view class="node-content">
            <view class="n-top">
              <text class="n-title">{{item.title}}</text>
              <text class="n-time">{{item.time}}</text>
            </view>
            <text class="n-desc">{{item.content}}</text>
          </view>
        </view>
      </block>
      <view class="node">
        <view class="node-dot"></view>
        <view class="node-content">
          <view class="n-top">
            <text class="n-title">系统录入</text>
            <text class="n-time">{{client.date}}</text>
          </view>
          <text class="n-desc">客户线索由【{{client.source}}】渠道自动归档。备注：{{client.remark || '无初始备注'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-action">
    <view class="btn secondary" bindtap="openModal">写跟进</view>
    <view class="btn primary" bindtap="onCall">
      <view class="icon icon-phone"></view> 拨打电话
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showInputModal}}" bindtap="closeModal">
    <view class="modal-box" catchtap="preventBubble">
      <view class="m-title">新增跟进记录</view>
      <textarea class="m-input" 
                placeholder="请输入跟进详情..." 
                placeholder-class="ph"
                bindinput="onInputRemark"
                value="{{tempRemark}}"
                maxlength="200"></textarea>
      <view class="m-btns">
        <view class="m-btn cancel" bindtap="closeModal">取消</view>
        <view class="m-btn confirm" bindtap="submitFollow">确认提交</view>
      </view>
    </view>
  </view>

  <view class="action-mask" wx:if="{{showActionSheet}}" bindtap="closeActionSheet">
    <view class="action-panel" catchtap="preventBubble">
      <block wx:if="{{isBroker}}">
        <view class="action-item warn" bindtap="onReleaseClient">放弃回公海</view>
      </block>
      <block wx:if="{{isAnchor}}">
        <view class="action-item" bindtap="openAssignModal">分配客户</view>
      </block>
      <view class="action-cancel" bindtap="closeActionSheet">取消</view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showAssignModal}}" bindtap="closeAssignModal">
    <view class="modal-box" catchtap="preventBubble">
      <view class="m-title">分配客户</view>
      <input class="m-input-short" 
             placeholder="请输入经纪人姓名 (如: 李销冠)" 
             placeholder-class="ph"
             bindinput="onInputBrokerName"
             value="{{tempBrokerName}}" />
      <view class="m-btns">
        <view class="m-btn cancel" bindtap="closeAssignModal">取消</view>
        <view class="m-btn confirm" bindtap="submitAssign">确认分配</view>
      </view>
    </view>
  </view>

</view>