page { background: #000; color: #fff; font-family: 'DIN', sans-serif; }
.container { padding-bottom: 140rpx; }

/* 1. 顶部身份卡 */
.header-card {
  background: #111;
  padding: 40rpx;
  border-bottom: 1rpx solid #222;
}
.h-top { display: flex; align-items: center; margin-bottom: 16rpx; }
.h-name { font-size: 48rpx; font-weight: bold; margin-right: 20rpx; }
.h-tag { 
  font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; 
  background: rgba(0, 174, 102, 0.15); color: #00ae66; 
}
.h-tag.deal { background: rgba(212, 176, 131, 0.15); color: #D4B083; }

.h-stars { display: flex; align-items: center; margin-bottom: 40rpx; }
.star-icon { font-size: 32rpx; color: #333; margin-right: 4rpx; }
.star-icon.active { color: #D4B083; }
.level-text { margin-left: 20rpx; font-size: 24rpx; color: #666; }

.data-grid { display: flex; flex-wrap: wrap; gap: 30rpx; }
.grid-item { width: 45%; }
.g-label { font-size: 22rpx; color: #666; display: block; margin-bottom: 8rpx; }
.g-val { font-size: 28rpx; color: #ddd; font-weight: bold; }
.g-val.phone { color: #fff; text-decoration: underline; }
.g-val.warn { color: #ff6b6b; }
.g-val.gold { color: #D4B083; }

/* 2. 时间轴 */
.timeline-box { padding: 40rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 30rpx; border-left: 6rpx solid #D4B083; padding-left: 20rpx; }

.timeline { position: relative; padding-left: 20rpx; }
/* 竖线 */
.timeline::before {
  content: ''; position: absolute; left: 0; top: 10rpx; bottom: 0;
  width: 2rpx; background: #222;
}

.node { position: relative; padding-left: 40rpx; margin-bottom: 50rpx; }
.node-dot {
  position: absolute; left: -9rpx; top: 10rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #222; border: 4rpx solid #000;
}
.node-dot.active { background: #D4B083; box-shadow: 0 0 10rpx rgba(212, 176, 131, 0.5); }

.n-top { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.n-title { font-size: 28rpx; font-weight: bold; color: #eee; }
.n-time { font-size: 22rpx; color: #666; }
.n-desc { font-size: 26rpx; color: #888; line-height: 1.5; }

/* 3. 底部操作 */
.footer-action {
  position: fixed; bottom: 0; left: 0; width: 100%;
  padding: 20rpx 40rpx 60rpx;
  background: #111;
  border-top: 1rpx solid #222;
  display: flex; gap: 30rpx;
  z-index: 90;
}
.btn {
  flex: 1; height: 90rpx; border-radius: 45rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: bold;
}
.btn.secondary { background: #222; color: #fff; border: 1rpx solid #333; }
.btn.primary { background: #D4B083; color: #000; }
.icon { font-size: 36rpx; margin-right: 10rpx; }

/* 4. 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.modal-box {
  width: 600rpx;
  background: #1a1a1a;
  border-radius: 16rpx;
  padding: 40rpx;
  border: 1rpx solid #333;
}
.m-title { font-size: 32rpx; font-weight: bold; color: #fff; margin-bottom: 30rpx; text-align: center; }
.m-input {
  width: 100%; height: 200rpx;
  background: #000;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  padding: 20rpx; box-sizing: border-box;
  font-size: 28rpx; color: #fff;
  margin-bottom: 30rpx;
}
.ph { color: #555; }

.m-btns { display: flex; gap: 20rpx; }
.m-btn { flex: 1; height: 80rpx; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }
.m-btn.cancel { background: #333; color: #aaa; }
.m-btn.confirm { background: #D4B083; color: #000; }/* ...原有样式保持不变... */

/* 🆕 右上角更多按钮 */
.more-btn {
  margin-left: auto; /* 挤到最右边 */
  font-size: 40rpx;
  color: #888;
  padding: 0 20rpx;
  transform: rotate(90deg); /* 竖排三个点 */
}

/* 🆕 底部 ActionSheet */
.action-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 100;
  display: flex; flex-direction: column; justify-content: flex-end;
}
.action-panel {
  background: #1a1a1a;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  overflow: hidden;
}
.action-item {
  height: 110rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #fff;
  border-bottom: 1rpx solid #222;
  background: #1a1a1a;
}
.action-item.warn { color: #ff6b6b; }
.action-item:active { background: #222; }

.action-cancel {
  height: 110rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #888;
  border-top: 12rpx solid #000; /* 分隔条 */
  background: #1a1a1a;
}

/* 🆕 短输入框 (用于分配弹窗) */
.m-input-short {
  width: 100%; height: 90rpx;
  background: #000;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  padding: 0 24rpx; box-sizing: border-box;
  font-size: 28rpx; color: #fff;
  margin-bottom: 40rpx;
}

/* 图标组件 */
.icon-star-full::before {
  content: '⭐';
}

.icon-phone::before {
  content: '☎';
}