page { background: #000; color: #fff; font-family: 'DIN', sans-serif; }
.container { padding-bottom: 120rpx; }

/* 1. 顶部统计 */
.header-stat {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx 0;
  background: #0a0a0a;
  border-bottom: 1rpx solid #1a1a1a;
}
.stat-box { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 40rpx; font-weight: bold; color: #fff; font-family: 'DIN'; }
.stat-num.gold { color: #D4B083; }
.stat-label { font-size: 22rpx; color: #666; margin-top: 6rpx; }
.stat-line { width: 1rpx; height: 40rpx; background: #222; }

/* 2. 搜索与筛选 (新增) */
.filter-section {
  background: #000;
  padding: 20rpx 30rpx 0;
  position: sticky; /* 吸顶效果 */
  top: 0;
  z-index: 99;
}

/* 搜索框 */
.search-box {
  background: #111;
  border: 1rpx solid #222;
  border-radius: 36rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #fff;
  margin-left: 16rpx;
}
.ph { color: #555; }
.clear-btn { color: #666; padding: 10rpx; font-size: 28rpx; }

/* Tab 切换 */
.tab-row {
  display: flex;
  border-bottom: 1rpx solid #1a1a1a;
}
.tab-item {
  margin-right: 40rpx;
  padding-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}
.tab-item.active {
  color: #D4B083;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #D4B083;
  border-radius: 4rpx;
}

/* 3. 列表区域 */
.client-list { padding: 30rpx; }

.client-card {
  background: #111;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid #222;
}

.card-left { flex: 1; }

.info-row-1 { display: flex; align-items: center; margin-bottom: 12rpx; }
.c-name { font-size: 32rpx; font-weight: bold; color: #fff; margin-right: 16rpx; }
.c-tag { 
  font-size: 20rpx; 
  padding: 2rpx 10rpx; 
  border-radius: 6rpx; 
  background: rgba(0, 174, 102, 0.15); 
  color: #00ae66; 
}
.c-tag.deal { 
  background: rgba(212, 176, 131, 0.15); 
  color: #D4B083; 
}

.info-row-2 { display: flex; gap: 20rpx; font-size: 22rpx; color: #666; margin-bottom: 12rpx; }

.info-row-spec {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.spec-tag {
  font-size: 20rpx;
  color: #888;
  background: #1a1a1a;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  border: 1rpx solid #333;
}
.spec-tag.warn {
  color: #ff6b6b; 
  border-color: rgba(255, 107, 107, 0.3);
  background: rgba(255, 107, 107, 0.1);
}
.spec-tag.info {
  color: #D4B083; 
  border-color: rgba(212, 176, 131, 0.3);
}

.info-row-3 { display: flex; gap: 4rpx; }
.star-mini { font-size: 20rpx; color: #333; }
.star-mini.active { color: #D4B083; }

/* 右侧拨号 */
.card-right { padding-left: 30rpx; border-left: 1rpx solid #222; }
.call-btn {
  width: 80rpx;
  height: 80rpx;
  background: #1a1a1a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #D4B083;
  border: 1rpx solid #D4B083;
  transition: all 0.2s;
  padding-bottom: 4rpx;
}
.call-btn:active { background: #D4B083; color: #000; }

.empty-tip { text-align: center; color: #444; font-size: 24rpx; margin-top: 100rpx; }

/* 悬浮新增按钮 */
.fab-add {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: #D4B083;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(212, 176, 131, 0.3);
  z-index: 100;
}
.plus { font-size: 60rpx; color: #000; font-weight: bold; margin-top: -6rpx; }