page { background: #000; color: #fff; }
.container { min-height: 100vh; padding: 60rpx 30rpx 120rpx; }

.header { text-align: center; margin-bottom: 60rpx; }
.title { font-size: 48rpx; font-weight: 900; color: #D4B083; display: block; margin-bottom: 16rpx; }
.subtitle { font-size: 20rpx; color: #666; display: block; letter-spacing: 6rpx; }

.form-card { background: #111; border: 1rpx solid #1a1a1a; border-radius: 20rpx; padding: 40rpx 30rpx; margin-bottom: 40rpx; }
.form-item { margin-bottom: 40rpx; }
.label { font-size: 26rpx; color: #888; display: block; margin-bottom: 20rpx; }
.label-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.quick-btn { font-size: 22rpx; color: #D4B083; padding: 6rpx 16rpx; background: rgba(212,176,131,0.1); border: 1rpx solid rgba(212,176,131,0.3); border-radius: 20rpx; }

.input { background: #0a0a0a; border: 1rpx solid #1a1a1a; border-radius: 12rpx; padding: 24rpx 20rpx; color: #fff; font-size: 28rpx; }

.tags { display: flex; flex-wrap: wrap; gap: 20rpx; }
.tag { padding: 20rpx 30rpx; background: #0a0a0a; border: 2rpx solid #1a1a1a; border-radius: 50rpx; font-size: 26rpx; color: #888; }
.tag.on { background: rgba(212,176,131,0.15); border-color: #D4B083; color: #D4B083; font-weight: bold; }

.radios { display: flex; flex-direction: column; gap: 20rpx; }
.radio { padding: 24rpx 20rpx; background: #0a0a0a; border: 1rpx solid #1a1a1a; border-radius: 12rpx; font-size: 26rpx; color: #ccc; }
.radio.on { border-color: #D4B083; background: rgba(212,176,131,0.1); color: #D4B083; }

.bottom { text-align: center; }
.btn { background: linear-gradient(135deg, #D4B083, #B38E5D); color: #000; font-weight: bold; border-radius: 50rpx; width: 100%; height: 100rpx; line-height: 100rpx; font-size: 32rpx; margin-bottom: 20rpx; }
.tip { font-size: 22rpx; color: #666; display: block; }

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.quick-fill-btn {
  font-size: 22rpx;
  color: #D4B083;
  padding: 6rpx 16rpx;
  background: rgba(212, 176, 131, 0.1);
  border: 1rpx solid rgba(212, 176, 131, 0.3);
  border-radius: 20rpx;
}

.quick-fill-btn:active {
  background: rgba(212, 176, 131, 0.2);
}

/* 图标组件 */
.icon-mobile::before {
  content: '📱';
}

.quick-icon {
  display: inline-flex;
  align-items: center;
  margin-right: 4rpx;
}