/* 黑金设计风格 */
/* 背景黑 (#0a0a0a), 文字白, 按钮金 (#d4af37) */

/* 基础样式 */
page {
  background-color: #0a0a0a;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #0a0a0a;
  padding-bottom: 100rpx; /* 为底部操作栏留出空间 */
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
}

.loading-text {
  color: #d4af37;
  font-size: 32rpx;
}

/* 错误状态 */
.error {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
}

.error-text {
  color: #ff4444;
  font-size: 32rpx;
}

/* 视频区域 */
.video-section {
  width: 100%;
  margin-bottom: 30rpx;
}

.video-container {
  position: relative;
  width: 100%;
  padding-top: 56.25%; /* 16:9 比例 */
  background-color: #111111;
  overflow: hidden;
}

.video-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #1a1a1a;
}

.video-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.video-title {
  font-size: 32rpx;
  color: #ffffff;
  text-align: center;
  padding: 0 40rpx;
}

/* 访客遮罩 */
.member-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
}

.mask-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

.mask-title {
  font-size: 48rpx;
  color: #d4af37;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.mask-desc {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  text-align: center;
}

.mask-btn {
  background-color: #d4af37;
  color: #0a0a0a;
  font-size: 32rpx;
  padding: 20rpx 60rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

/* 会员学习按钮 */
.learn-btn {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: #d4af37;
  color: #0a0a0a;
  font-size: 32rpx;
  padding: 20rpx 60rpx;
  border-radius: 8rpx;
  font-weight: bold;
  opacity: 0.9;
}

.learn-btn:hover {
  opacity: 1;
}

/* 课程信息 */
.course-info {
  padding: 30rpx;
  background-color: #111111;
  margin-bottom: 30rpx;
}

.course-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meta-item {
  font-size: 28rpx;
  color: #888888;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background-color: #111111;
  border-bottom: 2rpx solid #222222;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #888888;
  position: relative;
}

.tab-item.active {
  color: #d4af37;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background-color: #d4af37;
}

/* Tab内容 */
.tab-content {
  padding: 0 30rpx;
  min-height: 400rpx;
}

/* 简介内容 */
.intro-content {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.section-text {
  font-size: 32rpx;
  color: #cccccc;
  line-height: 1.6;
}

/* 目录内容 */
.catalog-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.catalog-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: #111111;
  border-radius: 8rpx;
}

.catalog-title {
  font-size: 32rpx;
  color: #ffffff;
}

.catalog-duration {
  font-size: 28rpx;
  color: #d4af37;
}

/* 讨论内容 */
.discussion-content {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.empty-discussion {
  text-align: center;
}

.empty-text {
  color: #888888;
  font-size: 32rpx;
}

/* 关联作业卡片 */
.related-article {
  margin: 30rpx;
  background-color: #111111;
  border-radius: 8rpx;
  overflow: hidden;
}

.article-card {
  padding: 30rpx;
  cursor: pointer;
  transition: all 0.3s;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border: 2rpx solid transparent;
}

/* 点击态效果 */
.article-card:hover,
.article-card.card-hover {
  background-color: #1a1a1a;
  border-color: #d4af37;
  transform: scale(0.98);
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  color: #d4af37;
  margin-bottom: 10rpx;
  display: block;
}

.card-content {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.4;
  word-break: break-all;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  height: 100%;
  margin-left: 20rpx;
}

.card-link {
  font-size: 32rpx;
  color: #d4af37;
  margin-bottom: 10rpx;
}

.card-arrow {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4af37;
  line-height: 1;
}

/* 底部固定操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #0a0a0a;
  border-top: 2rpx solid #222222;
  padding: 20rpx 0;
  z-index: 1000;
}

.bar-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 10rpx;
  cursor: pointer;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.bar-text {
  font-size: 24rpx;
  color: #cccccc;
}

.bar-item:hover .bar-text {
  color: #d4af37;
}

/* 图标组件 */
.icon-play::before {
  content: '▶️';
}

.icon-note::before {
  content: '📝';
}

.icon-star-full::before {
  content: '⭐';
}

.icon-link::before {
  content: '🔗';
}

.icon-chat::before {
  content: '💬';
}