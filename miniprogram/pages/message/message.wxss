page { background: #000; color: #fff; }
.container { padding: 30rpx; }

.header-tip { font-size: 28rpx; color: #666; margin-bottom: 30rpx; padding-left: 10rpx; }

.msg-item { 
  background: #111; padding: 36rpx; border-radius: 16rpx; margin-bottom: 24rpx; 
  display: flex; border: 1rpx solid #222; position: relative;
}
.dot { width: 14rpx; height: 14rpx; background: #ff4d4f; border-radius: 50%; position: absolute; top: 40rpx; left: 20rpx; }
.dot.read { background: #333; }

.content { flex: 1; margin-left: 20rpx; }
.msg-top { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.title { font-size: 30rpx; font-weight: bold; color: #fff; }
.time { font-size: 22rpx; color: #666; }
.txt { font-size: 26rpx; line-height: 1.5; color: #aaa; display: block; }