.materials-container { min-height: 100vh; background: #0a0a0a; padding-bottom: 120rpx; }
.tabs { display: flex; background: #111; border-bottom: 2rpx solid #222; }
.tab { flex: 1; text-align: center; padding: 32rpx 0; font-size: 32rpx; color: #666; position: relative; }
.tab.active { color: #D4B083; font-weight: bold; }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 80rpx; height: 4rpx; background: #D4B083; }
.material-list { padding: 24rpx; }
.text-item { background: #111; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; border: 2rpx solid #222; }
.text-content { color: #fff; font-size: 28rpx; line-height: 1.6; margin-bottom: 24rpx; }
.text-meta { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.tag { background: rgba(212,176,131,0.1); color: #D4B083; padding: 8rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; }
.date { color: #666; font-size: 24rpx; }
.btn-copy { background: #D4B083; color: #0a0a0a; font-size: 28rpx; padding: 16rpx 48rpx; border-radius: 8rpx; }
.image-item { position: relative; margin-bottom: 24rpx; border-radius: 16rpx; overflow: hidden; }
.material-image { width: 100%; height: 400rpx; }
.image-meta { position: absolute; top: 16rpx; left: 16rpx; }
.fab { position: fixed; right: 32rpx; bottom: 32rpx; width: 112rpx; height: 112rpx; background: #D4B083; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 64rpx; color: #0a0a0a; box-shadow: 0 8rpx 24rpx rgba(212,176,131,0.3); }