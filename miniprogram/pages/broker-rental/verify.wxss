.container {
  min-height: 100vh;
  background: #0a0a0a;
}

.tab-bar {
  display: flex;
  background: rgba(212, 176, 131, 0.05);
  padding: 8rpx;
  margin: 24rpx 32rpx;
  border-radius: 12rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.tab.active {
  background: #D4B083;
  color: #0a0a0a;
  font-weight: 600;
}

.tenant-list {
  padding: 0 32rpx;
}

.tenant-card {
  background: rgba(212, 176, 131, 0.08);
  border: 1px solid rgba(212, 176, 131, 0.2);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.tenant-name {
  color: #D4B083;
  font-size: 32rpx;
  font-weight: 600;
}

.phone {
  color: #4A9EFF;
  font-size: 28rpx;
  text-decoration: underline;
}

.address {
  color: #fff;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.time {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.verify-btn {
  background: linear-gradient(135deg, #D4B083 0%, #B8935C 100%);
  color: #0a0a0a;
  text-align: center;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.empty {
  color: #666;
  text-align: center;
  margin-top: 200rpx;
  font-size: 28rpx;
}