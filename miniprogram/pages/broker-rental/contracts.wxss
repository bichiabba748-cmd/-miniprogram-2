.container {
  min-height: 100vh;
  background: #0a0a0a;
}

.tab-bar {
  display: flex;
  background: rgba(212, 176, 131, 0.05);
  padding: 8rpx;
  margin: 24rpx 32rpx;
  border-radius: 12rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 28rpx;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #D4B083;
  color: #0a0a0a;
  font-weight: 600;
}

.contract-list {
  padding: 0 32rpx;
}

.contract-card {
  background: rgba(212, 176, 131, 0.08);
  border: 1px solid rgba(212, 176, 131, 0.2);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.address {
  color: #D4B083;
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
}

.rent {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 20rpx;
}

.card-info {
  display: flex;
  justify-content: space-between;
  color: #999;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.days-left {
  color: #ff6b6b;
  font-size: 24rpx;
  text-align: right;
}

.empty {
  color: #666;
  text-align: center;
  margin-top: 200rpx;
  font-size: 28rpx;
}