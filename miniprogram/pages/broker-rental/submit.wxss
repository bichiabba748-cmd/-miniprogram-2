.container {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 32rpx;
}

.form-section {
  margin-bottom: 48rpx;
}

.section-title {
  color: #D4B083;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.input-field, .picker-field {
  background: rgba(212, 176, 131, 0.08);
  border: 1px solid rgba(212, 176, 131, 0.2);
  border-radius: 8rpx;
  padding: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.picker-field {
  color: #999;
}

.submit-btn {
  background: linear-gradient(135deg, #D4B083 0%, #B8935C 100%);
  color: #0a0a0a;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 80rpx;
}