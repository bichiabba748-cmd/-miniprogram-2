.container {
  background-color: #0a0a0a;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 30rpx;
  background-color: #111;
  border-bottom: 1rpx solid #333;
}

.header-left, .header-right {
  width: 60rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #D4B083;
  font-weight: bold;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4B083;
  font-family: 'DIN', sans-serif;
}

/* 状态切换 */
.status-tabs {
  display: flex;
  background-color: #111;
  margin: 30rpx;
  border-radius: 15rpx;
  border: 1rpx solid #333;
}

.tab-item {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background-color: rgba(212, 176, 131, 0.1);
  border: 1rpx solid #D4B083;
}

.tab-text {
  font-size: 32rpx;
  color: #999;
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: #D4B083;
  font-weight: bold;
}

/* 收藏列表 */
.collection-list {
  padding: 0 30rpx;
}

.collection-item {
  background-color: #111;
  border-radius: 20rpx;
  border: 1rpx solid #333;
  padding: 30rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.collection-item:hover {
  border-color: #D4B083;
  box-shadow: 0 4rpx 12rpx rgba(212, 176, 131, 0.1);
}

.item-content {
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.item-category {
  font-size: 24rpx;
  color: #D4B083;
  background-color: rgba(212, 176, 131, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #D4B083;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.item-time {
  font-size: 24rpx;
  color: #666;
}

.item-status {
  font-size: 24rpx;
  color: #D4B083;
  background-color: rgba(212, 176, 131, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.item-preview {
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #333;
}

.preview-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作按钮 */
.item-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #333;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 15rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.primary-btn {
  background-color: rgba(212, 176, 131, 0.1);
  color: #D4B083;
  border: 1rpx solid #D4B083;
}

.primary-btn:hover {
  background-color: rgba(212, 176, 131, 0.2);
}

.secondary-btn {
  background-color: transparent;
  color: #999;
  border: 1rpx solid #333;
}

.secondary-btn:hover {
  color: #D4B083;
  border-color: #D4B083;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 30rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.empty-btn {
  height: 90rpx;
  padding: 0 60rpx;
  background-color: rgba(212, 176, 131, 0.1);
  color: #D4B083;
  border: 1rpx solid #D4B083;
  border-radius: 45rpx;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.empty-btn:hover {
  background-color: rgba(212, 176, 131, 0.2);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 30rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
  animation: spin 2s linear infinite;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 按钮样式重置 */
button {
  padding: 0;
  background: none;
  border: none;
  outline: none;
}

button::after {
  border: none;
}

/* 图标组件 */
.icon-list::before {
  content: '📋';
}

.icon-loading::before {
  content: '⏳';
}