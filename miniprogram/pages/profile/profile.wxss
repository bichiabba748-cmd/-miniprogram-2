page { background: #000; color: #fff; font-family: 'DIN', sans-serif; }
.container { padding: 0 0 120rpx; }

.header-card { padding: 60rpx 40rpx; background: #000; display: flex; justify-content: space-between; align-items: center; }
.user-info-section { display: flex; align-items: center; }

.simple-avatar-box {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.simple-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 3rpx solid #D4B083;
  box-shadow: 0 0 12rpx rgba(212, 176, 131, 0.4);
  display: block;
}

.role-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  background: #D4B083;
  color: #000;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  white-space: nowrap;
}

.name { font-size: 38rpx; font-weight: 900; display: block; margin-bottom: 8rpx; color: #fff; }
.desc { font-size: 22rpx; color: #444; }

.dashboard-section { display: flex; padding: 0 30rpx; gap: 20rpx; margin-bottom: 30rpx; position: relative; }
.dash-card { flex: 1; background: #111; padding: 30rpx; border-radius: 16rpx; border: 1rpx solid #1a1a1a; position: relative; }

.dashboard-wrapper {
  position: absolute;
  bottom: -24rpx;
  right: 30rpx;
}

.contribute-btn {
  background: linear-gradient(135deg, #D4B083 0%, #F5D76E 100%);
  color: #000;
  font-weight: bold;
  font-size: 22rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(212, 176, 131, 0.3);
  transition: transform 0.2s ease;
}

.contribute-btn:active {
  transform: scale(0.95);
}

.visitor-blur {
  filter: blur(4rpx);
  opacity: 0.7;
}

.dash-card.locked {
  position: relative;
}

.visitor-lock {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #D4B083;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: bold;
  z-index: 10;
}
.dash-top { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.dash-label { font-size: 22rpx; color: #555; }
.dash-icon { font-size: 28rpx; }

/* 图标组件 */
.icon-video::before {
  content: '🎥';
}

.icon-bookmark::before {
  content: '🔖';
}

.icon-phone::before {
  content: '⏱️';
}

.icon-trophy::before {
  content: '🏆';
}

.icon-chart::before {
  content: '📊';
}

.icon-users::before {
  content: '👥';
}

.dash-value { font-size: 50rpx; font-weight: 900; color: #D4B083; font-family: 'DIN'; }
.unit { font-size: 20rpx; margin-left: 6rpx; color: #333; }
.dash-progress { height: 6rpx; background: #000; margin-top: 15rpx; border-radius: 3rpx; overflow: hidden; }
.fill { height: 100%; background: #D4B083; border-radius: 3rpx; }
.dash-sub { font-size: 18rpx; color: #333; margin-top: 10rpx; display: block; }

.content-card { background: #111; margin: 0 30rpx 30rpx; padding: 30rpx; border-radius: 16rpx; border: 1rpx solid #1a1a1a; }
.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.card-title { font-size: 26rpx; font-weight: bold; color: #888; }
.card-action { font-size: 20rpx; color: #444; }
.card-action.gold { color: #D4B083; }

.recent-item { display: flex; align-items: center; background: #0a0a0a; padding: 15rpx; border-radius: 8rpx; }
.recent-cover { width: 80rpx; height: 50rpx; background: #222; border-radius: 4rpx; margin-right: 20rpx; }
.recent-info { flex: 1; }
.r-title { font-size: 24rpx; color: #eee; display: block; }
.r-status { font-size: 18rpx; color: #444; }
.resume-btn { font-size: 20rpx; color: #D4B083; border: 1rpx solid #D4B083; padding: 6rpx 20rpx; border-radius: 30rpx; }

.medal-scroll { width: 100%; white-space: nowrap; }
.medal-flex { display: flex; gap: 40rpx; }
.medal-item { display: flex; flex-direction: column; align-items: center; min-width: 90rpx; }
.medal-item.locked { filter: grayscale(1); opacity: 0.15; }
.m-icon { font-size: 44rpx; margin-bottom: 10rpx; }
.m-name { font-size: 18rpx; color: #444; }

/* Task 2: 放大榜单头像至80rpx */
.rank-row { display: flex; align-items: center; padding: 25rpx 0; border-bottom: 1rpx solid #1a1a1a; }
.row-idx { width: 40rpx; font-family: 'DIN'; color: #333; font-size: 26rpx; }
.gold-idx { color: #D4B083; font-weight: 900; }
.row-avatar { 
  width: 80rpx; /* 原55rpx，放大至80rpx */
  height: 80rpx; /* 原55rpx，放大至80rpx */
  border-radius: 50%; 
  margin: 0 20rpx; 
  /* 直接使用border，和首页保持一致 */
  border: 2rpx solid #333;
  /* 移除background，使用真实图片 */
}
.row-info { flex: 1; }
.row-name { font-size: 24rpx; color: #ccc; }
.row-store { font-size: 16rpx; color: #444; display: block; }
.row-val { font-size: 24rpx; color: #D4B083; font-family: 'DIN'; font-weight: bold; }

/* Task 2: 访客显示底部锁 */
.lock-footer { text-align: center; font-size: 18rpx; color: #333; margin-top: 30rpx; }

/* Task 3: 学习打卡模块样式 */
.study-calendar {
  margin-top: 20rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.calendar-day {
  text-align: center;
  font-size: 20rpx;
  color: #666;
  padding: 10rpx 0;
}

.calendar-date {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #888;
  background: #222;
  border-radius: 50%;
  margin: 0 auto;
}

.calendar-date.checked {
  background: #D4B083;
  color: #000;
  font-weight: bold;
}

.calendar-date.today {
  background: #07c160;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 0 10rpx rgba(7, 193, 96, 0.5);
}

.calendar-tip {
  text-align: center;
  font-size: 22rpx;
  color: #666;
  margin-top: 20rpx;
}

.admin-test-bar { 
  position: fixed; bottom: 0; left: 0; width: 100%; 
  display: flex; background: #0a0a0a; padding: 20rpx; border-top: 1rpx solid #1a1a1a; 
}
.t-btn { flex: 1; margin: 0 10rpx; font-size: 20rpx; height: 60rpx; line-height: 60rpx; }
.t-btn.reset { background: #222; color: #666; }
.t-btn.switch { background: rgba(212, 176, 131, 0.1); color: #D4B083; border: 1rpx solid #D4B083; }

/* 新秀榜预览样式 */
.rookie-preview {
  background: linear-gradient(135deg, rgba(212, 176, 131, 0.1) 0%, rgba(245, 215, 110, 0.05) 100%);
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(212, 176, 131, 0.3);
}

.rp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.rp-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #D4B083;
}

.rp-more {
  font-size: 20rpx;
  color: #444;
}

.rp-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rp-avatars {
  display: flex;
  gap: 15rpx;
}

.rp-av-box { position: relative; margin-right: 15rpx; }
.rp-av { width: 60rpx; height: 60rpx; border-radius: 50%; border: 2rpx solid #666; display: block; }
.rp-rank-tag {
  position: absolute; bottom: -6rpx; right: -6rpx;
  width: 24rpx; height: 24rpx; line-height: 24rpx;
  text-align: center; font-size: 16rpx; border-radius: 50%; color: #000; font-weight: bold;
}
.r1 { background: #FFD700; } /* 金 */
.r2 { background: #C0C0C0; } /* 银 */
.r3 { background: #CD7F32; } /* 铜 */

.rp-desc {
  font-size: 22rpx;
  color: #888;
}

/* 勋章详情弹窗样式 */
.medal-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.medal-modal-content {
  background: #0a0a0a;
  border: 2rpx solid #D4B083;
  border-radius: 20rpx;
  width: 80%;
  max-width: 500rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(212, 176, 131, 0.3);
}

.medal-modal-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.medal-modal-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.medal-modal-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4B083;
  display: block;
  margin-bottom: 10rpx;
}

.medal-modal-status {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.medal-modal-body {
  margin-bottom: 30rpx;
}

.medal-progress {
  margin-bottom: 30rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #D4B083;
  display: block;
  margin-bottom: 15rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #333;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4B083, #F4D092);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-value {
  font-size: 24rpx;
  color: #999;
  float: right;
}

.medal-condition {
  clear: both;
}

.condition-label {
  font-size: 28rpx;
  color: #D4B083;
  display: block;
  margin-bottom: 15rpx;
}

.condition-desc {
  font-size: 24rpx;
  color: #ccc;
  line-height: 1.5;
}

.medal-modal-footer {
  text-align: center;
}

.close-btn {
  background: #333;
  color: #D4B083;
  border: 1rpx solid #D4B083;
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 15rpx 40rpx;
  margin-top: 10rpx;
}

.close-btn:hover {
  background: #D4B083;
  color: #0a0a0a;
}
