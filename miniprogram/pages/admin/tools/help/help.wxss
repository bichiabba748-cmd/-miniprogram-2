/* 帮助页面样式 */

/* 全局样式 */
.help-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx;
}

/* 帮助概览 */
.overview-section {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 16rpx;
}

.overview-desc {
  font-size: 24rpx;
  color: #cccccc;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.quick-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.quick-link {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background-color: #1a1a1a;
  color: #D4B083;
  font-size: 20rpx;
  border: 1rpx solid #D4B083;
  font-weight: 500;
}

/* 帮助分类 */
.categories-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-item {
  background-color: #111111;
  border-radius: 16rpx;
  border: 1rpx solid #333333;
  overflow: hidden;
}

.category-header {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.category-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.category-icon {
  font-size: 24rpx;
  color: #D4B083;
  transition: transform 0.3s ease;
}

.category-icon.expanded {
  transform: rotate(180deg);
}

.category-content {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #333333;
}

/* 帮助项 */
.help-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #333333;
}

.help-item:last-child {
  border-bottom: none;
}

.help-question {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.help-answer {
  font-size: 20rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.help-tips {
  font-size: 20rpx;
  color: #D4B083;
  background-color: #1a1a1a;
  padding: 16rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #D4B083;
  margin-top: 8rpx;
}

/* 常见问题 */
.faq-section {
  margin-bottom: 32rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.faq-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.faq-question {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.faq-answer {
  font-size: 20rpx;
  color: #999999;
  line-height: 1.5;
}

/* 联系支持 */
.support-section {
  margin-bottom: 32rpx;
}

.support-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
  text-align: center;
}

.support-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.support-desc {
  font-size: 24rpx;
  color: #cccccc;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.support-btn {
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  background-color: #D4B083;
  color: #000000;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
}

/* 版本信息 */
.version-section {
  padding: 0 24rpx 32rpx;
}

.version-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
  text-align: center;
}

.version-info {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.version-number {
  font-size: 24rpx;
  font-weight: 500;
  color: #D4B083;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .overview-desc {
    font-size: 22rpx;
  }
  
  .quick-link {
    font-size: 18rpx;
    padding: 10rpx 20rpx;
  }
  
  .support-btn {
    padding: 20rpx 40rpx;
    font-size: 22rpx;
  }
}

/* 图标组件 */
.icon-chart::before {
  content: '📊';
}

.icon-hospital::before {
  content: '🏥';
}

.icon-save::before {
  content: '💾';
}

.icon-package::before {
  content: '📦';
}

.icon-lightning::before {
  content: '⚡';
}

.icon-puzzle::before {
  content: '🧩';
}

.feature-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
