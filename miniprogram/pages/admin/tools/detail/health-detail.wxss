/* 健康状态详情页面样式 */

/* 全局样式 */
.detail-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
  white-space: nowrap;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx;
}

/* 健康概览 */
.overview-section {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.health-score {
  text-align: center;
  margin-bottom: 32rpx;
}

.score-value {
  font-size: 96rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.score-level {
  font-size: 32rpx;
  font-weight: 600;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
  display: inline-block;
}

.score-level.excellent {
  background-color: #52c41a;
  color: #000000;
}

.score-level.good {
  background-color: #1890ff;
  color: #ffffff;
}

.score-level.warning {
  background-color: #faad14;
  color: #000000;
}

.score-level.poor {
  background-color: #ff4d4f;
  color: #ffffff;
}

.score-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
  text-align: center;
}

/* 健康指标 */
.metrics-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.metrics-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.metric-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.metric-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.metric-info {
  flex: 1;
}

.metric-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.metric-desc {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.metric-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 指标进度条 */
.metric-progress {
  margin-top: 16rpx;
}

.progress-track {
  height: 12rpx;
  background-color: #333333;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-fill.excellent {
  background-color: #52c41a;
}

.progress-fill.good {
  background-color: #1890ff;
}

.progress-fill.warning {
  background-color: #faad14;
}

.progress-fill.poor {
  background-color: #ff4d4f;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: #999999;
}

/* 问题列表 */
.issues-section {
  margin-bottom: 32rpx;
}

.issues-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.indicator-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.indicator-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.indicator-action {
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  background-color: rgba(212, 176, 131, 0.2);
  border: 1rpx solid rgba(212, 176, 131, 0.4);
}

.indicator-action .action-text {
  font-size: 20rpx;
  color: #D4B083;
}

.issue-info {
  flex: 1;
}

.issue-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.issue-severity {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.issue-severity.critical {
  background-color: #ff4d4f;
  color: #ffffff;
}

.issue-severity.high {
  background-color: #faad14;
  color: #000000;
}

.issue-severity.medium {
  background-color: #1890ff;
  color: #ffffff;
}

.issue-severity.low {
  background-color: #52c41a;
  color: #000000;
}

.issue-desc {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.issue-recommendation {
  font-size: 20rpx;
  color: #cccccc;
  background-color: #1a1a1a;
  padding: 16rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #D4B083;
}

/* 操作按钮 */
.action-section {
  padding: 0 24rpx 32rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
}

.action-btn.primary {
  background-color: #D4B083;
  color: #000000;
}

.action-btn.secondary {
  background-color: #1a1a1a;
  color: #D4B083;
  border: 1rpx solid #D4B083;
}

/* 问题列表样式 */
.issue-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.issue-info {
  flex: 1;
  margin-right: 16rpx;
}

.issue-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.issue-action {
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.issue-action.copy {
  background-color: rgba(212, 176, 131, 0.2);
  border: 1rpx solid rgba(212, 176, 131, 0.4);
}

.issue-action.copy:hover {
  background-color: rgba(212, 176, 131, 0.3);
}

.issue-action .action-text {
  color: #D4B083;
  font-size: 22rpx;
}

.btn-text {
  font-size: 24rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .score-value {
    font-size: 72rpx;
  }
  
  .score-level {
    font-size: 24rpx;
  }
  
  .action-section {
    flex-direction: column;
  }
}
