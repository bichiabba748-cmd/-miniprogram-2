/* 云函数详情页面样式 */

/* 全局样式 */
.detail-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
  white-space: nowrap;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx;
}

/* 函数列表 */
.function-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.function-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.function-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.function-info {
  flex: 1;
}

.function-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.function-desc {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.function-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.function-status.active {
  background-color: #52c41a;
  color: #000000;
}

.function-status.inactive {
  background-color: #ff4d4f;
  color: #ffffff;
}

.function-status.error {
  background-color: #faad14;
  color: #000000;
}

/* 函数详情 */
.function-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #333333;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 20rpx;
}

.detail-label {
  color: #999999;
}

.detail-value {
  color: #cccccc;
  font-weight: 500;
}

/* 调用统计 */
.stats-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #333333;
}

.stats-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #D4B083;
  margin-bottom: 16rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-card {
  background-color: #1a1a1a;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 18rpx;
  color: #999999;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  border: none;
  font-weight: 500;
}

.action-btn.test {
  background-color: #1890ff;
  color: #ffffff;
}

.action-btn.deploy {
  background-color: #52c41a;
  color: #000000;
}

.action-btn.logs {
  background-color: #faad14;
  color: #000000;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .action-buttons {
    flex-direction: column;
  }
}
