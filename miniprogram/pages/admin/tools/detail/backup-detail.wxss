/* 备份详情页面样式 */

/* 全局样式 */
.detail-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
  white-space: nowrap;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx;
}

/* 备份概览 */
.overview-section {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.overview-card {
  text-align: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 20rpx;
  color: #999999;
}

/* 备份列表 */
.backups-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.backup-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.backup-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.backup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.backup-info {
  flex: 1;
}

.backup-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.backup-date {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.backup-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.backup-status.success {
  background-color: #52c41a;
  color: #000000;
}

.backup-status.failed {
  background-color: #ff4d4f;
  color: #ffffff;
}

.backup-status.pending {
  background-color: #faad14;
  color: #000000;
}

/* 备份详情 */
.backup-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #333333;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 20rpx;
}

.detail-label {
  color: #999999;
}

.detail-value {
  color: #cccccc;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  border: none;
  font-weight: 500;
}

.action-btn.restore {
  background-color: #1890ff;
  color: #ffffff;
}

.action-btn.download {
  background-color: #52c41a;
  color: #000000;
}

.action-btn.delete {
  background-color: #ff4d4f;
  color: #ffffff;
}

/* 操作按钮区域 */
.bottom-actions {
  padding: 0 24rpx 32rpx;
  display: flex;
  gap: 16rpx;
}

.bottom-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
}

.bottom-btn.primary {
  background-color: #D4B083;
  color: #000000;
}

.bottom-btn.secondary {
  background-color: #1a1a1a;
  color: #D4B083;
  border: 1rpx solid #D4B083;
}

.btn-text {
  font-size: 24rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .overview-grid {
    grid-template-columns: 1fr;
  }
  
  .overview-value {
    font-size: 36rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
  
  .bottom-actions {
    flex-direction: column;
  }
}
