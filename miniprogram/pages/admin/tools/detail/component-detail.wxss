/* 组件详情页面样式 */

/* 全局样式 */
.detail-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
  white-space: nowrap;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx;
}

/* 组件库概览 */
.overview-section {
  padding: 32rpx 24rpx;
}

.overview-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-value.good {
  color: #52c41a;
}

.stat-value.warning {
  color: #faad14;
}

.stat-label {
  font-size: 20rpx;
  color: #999999;
}

/* 组件使用情况 */
.usage-section {
  padding: 0 24rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.usage-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.usage-chart {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chart-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-color.used {
  background-color: #52c41a;
}

.legend-color.unused {
  background-color: #ff4d4f;
}

.legend-text {
  font-size: 20rpx;
  color: #cccccc;
}

.chart-pie {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 32rpx 0;
}

.pie-container {
  position: relative;
  width: 300rpx;
  height: 300rpx;
}

.pie-slice {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pie-slice.used {
  background-color: #52c41a;
}

.pie-slice.unused {
  background-color: #ff4d4f;
}

.pie-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background-color: #111111;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #333333;
}

.center-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #D4B083;
  margin-bottom: 8rpx;
}

.center-label {
  font-size: 20rpx;
  color: #999999;
}

/* 组件列表 */
.components-section {
  padding: 0 24rpx 32rpx;
}

.component-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.component-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.component-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.component-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.component-status.active {
  background-color: #52c41a;
  color: #000000;
}

.component-status.inactive {
  background-color: #ff4d4f;
  color: #ffffff;
}

.component-status.warning {
  background-color: #faad14;
  color: #000000;
}

.component-details {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #333333;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-label {
  font-size: 18rpx;
  color: #999999;
}

.detail-value {
  font-size: 18rpx;
  font-weight: 500;
  color: #cccccc;
}

.component-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  border: none;
  font-weight: 500;
}

.action-btn.view {
  background-color: #1890ff;
  color: #ffffff;
}

.action-btn.optimize {
  background-color: #52c41a;
  color: #000000;
}

.action-btn.delete {
  background-color: #ff4d4f;
  color: #ffffff;
}

.action-btn.disable {
  background-color: #faad14;
  color: #000000;
}

/* 组件分类 */
.categories-section {
  padding: 0 24rpx 32rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background-color: #1a1a1a;
  border-radius: 12rpx;
}

.category-info {
  flex: 1;
}

.category-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 20rpx;
  color: #999999;
}

.category-percentage {
  font-size: 24rpx;
  font-weight: bold;
  color: #D4B083;
}

/* 未使用组件 */
.unused-section {
  padding: 0 24rpx 32rpx;
}

.unused-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.unused-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background-color: #1a1a1a;
  border-radius: 12rpx;
}

.unused-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  flex: 1;
}

.unused-actions {
  display: flex;
  gap: 12rpx;
}

/* 优化建议 */
.suggestions-section {
  padding: 0 24rpx 32rpx;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #111111;
  border-radius: 16rpx;
  border: 1rpx solid #333333;
}

.suggestion-icon {
  font-size: 32rpx;
  margin-top: 4rpx;
}

.suggestion-content {
  flex: 1;
  margin-right: 16rpx;
}

.suggestion-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.suggestion-desc {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.suggestion-impact {
  font-size: 18rpx;
  color: #D4B083;
  font-weight: 500;
}

.suggestion-action {
  padding: 12rpx 24rpx;
  background-color: #D4B083;
  color: #000000;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  align-self: center;
  cursor: pointer;
}

.action-text {
  font-size: 20rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .overview-stats {
    grid-template-columns: 1fr;
  }
  
  .stat-value {
    font-size: 36rpx;
  }
  
  .chart-legend {
    flex-direction: column;
    align-items: center;
    gap: 16rpx;
  }
  
  .pie-container {
    width: 240rpx;
    height: 240rpx;
  }
  
  .pie-center {
    width: 140rpx;
    height: 140rpx;
  }
  
  .center-text {
    font-size: 36rpx;
  }
  
  .component-actions {
    flex-direction: column;
  }
  
  .action-btn {
    width: 100%;
  }
  
  .detail-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 12rpx;
  }
  
  .detail-item {
    width: 100%;
  }
  
  .suggestion-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .suggestion-action {
    align-self: flex-end;
    margin-top: 12rpx;
  }
}
