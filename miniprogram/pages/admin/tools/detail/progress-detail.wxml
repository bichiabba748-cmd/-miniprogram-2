<!-- 开发进度详情页面 -->
<view class="detail-container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="navigateBack">
      <text class="nav-back">← 返回</text>
    </view>
    <view class="nav-title">开发进度详情</view>
    <view class="nav-right"></view>
  </view>

  <!-- 总体进度 -->
  <view class="summary-section">
    <view class="summary-card">
      <view class="summary-title">总体进度</view>
      <view class="summary-value">{{totalProgress}}%</view>
      <view class="summary-desc">{{currentStage}}</view>
      <view class="summary-time">最近更新: {{lastUpdated}}</view>
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress-section">
    <view class="progress-container">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{totalProgress}}%"></view>
      </view>
      <view class="progress-markers">
        <view class="marker" style="left: 0%">
          <view class="marker-dot"></view>
          <view class="marker-label">开始</view>
        </view>
        <view class="marker" style="left: 25%">
          <view class="marker-dot {{totalProgress >= 25 ? 'active' : ''}}"></view>
          <view class="marker-label">需求分析</view>
        </view>
        <view class="marker" style="left: 50%">
          <view class="marker-dot {{totalProgress >= 50 ? 'active' : ''}}"></view>
          <view class="marker-label">开发阶段</view>
        </view>
        <view class="marker" style="left: 75%">
          <view class="marker-dot {{totalProgress >= 75 ? 'active' : ''}}"></view>
          <view class="marker-label">测试阶段</view>
        </view>
        <view class="marker" style="left: 100%">
          <view class="marker-dot {{totalProgress >= 100 ? 'active' : ''}}"></view>
          <view class="marker-label">完成</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 进度区块 -->
  <view class="sections-section">
    <view class="section-title">开发进度</view>
    <view class="section-list">
      <view class="section-item" wx:for="{{sections}}" wx:key="index">
        <view class="section-header">
          <view class="section-info">
            <view class="section-name">{{item.name}}</view>
            <view class="section-status {{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="section-percentage">{{item.progress}}%</view>
        </view>
        <view class="section-progress">
          <view class="section-progress-track">
            <view class="section-progress-fill" style="width: {{item.progress}}%; background-color: {{item.status === 'completed' ? '#52c41a' : item.status === 'in_progress' ? '#faad14' : '#d9d9d9'}}"></view>
          </view>
        </view>
        
        <!-- 已完成：只显示区块标题，不显示详细任务 -->
        <view wx:if="{{item.status === 'completed'}}" class="section-completed-hint">
          <text class="hint-text">✓ 该区块已完成</text>
        </view>
        
        <!-- 进行中或待开发：显示详细任务列表 -->
        <view wx:if="{{item.status !== 'completed'}}" class="task-list">
          <view class="task-item" wx:for="{{item.tasks}}" wx:for-item="task" wx:for-index="taskIndex" wx:key="taskIndex">
            <view class="task-checkbox {{task.completed ? 'checked' : ''}}">
              <text wx:if="{{task.completed}}" class="task-icon">✓</text>
            </view>
            <view class="task-text">{{task.name}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史进度 -->
  <view class="history-section">
    <view class="section-title">历史进度</view>
    <view class="history-chart">
      <view class="chart-container">
        <view class="chart-grid">
          <view class="grid-line" wx:for="{{[0, 20, 40, 60, 80, 100]}}" wx:key="index">
            <view class="grid-mark">{{item}}%</view>
          </view>
        </view>
        <view class="chart-data">
          <view class="data-point" wx:for="{{historyData}}" wx:key="index">
            <view class="point-dot" style="left: {{(index / (historyData.length - 1)) * 100}}%; bottom: {{item.progress}}%"></view>
            <view class="point-label" style="left: {{(index / (historyData.length - 1)) * 100}}%">{{item.date}}</view>
          </view>
          <view class="data-line">
            <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
              <polyline
                points="{{getSvgPoints()}}"
                fill="none"
                stroke="#1890ff"
                stroke-width="2"
              />
              <polygon
                points="{{getSvgAreaPoints()}}"
                fill="rgba(24, 144, 255, 0.2)"
              />
            </svg>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="action-btn primary" bindtap="refreshProgress">
      <text class="btn-text">刷新进度</text>
    </button>
    <button class="action-btn secondary" bindtap="exportProgress">
      <text class="btn-text">导出报告</text>
    </button>
  </view>
</view>