/* 开发进度详情页面样式 */

/* 全局样式 */
.detail-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
  white-space: nowrap;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 总体进度 */
.summary-section {
  padding: 32rpx 24rpx;
}

.summary-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
}

.summary-title {
  font-size: 28rpx;
  color: #D4B083;
  margin-bottom: 16rpx;
}

.summary-value {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.summary-desc {
  font-size: 24rpx;
  color: #cccccc;
  margin-bottom: 16rpx;
}

.summary-time {
  font-size: 20rpx;
  color: #999999;
}

/* 进度条 */
.progress-section {
  padding: 0 24rpx 32rpx;
}

.progress-container {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
}

.progress-track {
  height: 12rpx;
  background-color: #333333;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.progress-fill {
  height: 100%;
  background-color: #D4B083;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-markers {
  position: relative;
  height: 60rpx;
}

.marker {
  position: absolute;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.marker-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #333333;
  margin-bottom: 8rpx;
  border: 2rpx solid #666666;
}

.marker-dot.active {
  background-color: #D4B083;
  border-color: #D4B083;
}

.marker-label {
  font-size: 20rpx;
  color: #999999;
  white-space: nowrap;
}

/* 进度区块 */
.sections-section {
  padding: 0 24rpx 32rpx;
}

.section-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-item {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.section-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.section-status.completed {
  background-color: #52c41a;
  color: #000000;
}

.section-status.in_progress {
  background-color: #faad14;
  color: #000000;
}

.section-status.pending {
  background-color: #d9d9d9;
  color: #000000;
}

.section-percentage {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.section-progress {
  margin-bottom: 16rpx;
}

.section-progress-track {
  height: 8rpx;
  background-color: #333333;
  border-radius: 4rpx;
  overflow: hidden;
}

.section-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.section-completed-hint {
  padding: 16rpx;
  background-color: #1a1a1a;
  border-radius: 8rpx;
  text-align: center;
}

.hint-text {
  font-size: 20rpx;
  color: #52c41a;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background-color: #1a1a1a;
  border-radius: 8rpx;
}

.task-checkbox {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 2rpx solid #666666;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.task-checkbox.checked {
  background-color: #D4B083;
  border-color: #D4B083;
}

.task-icon {
  font-size: 16rpx;
  color: #000000;
  font-weight: bold;
}

.task-text {
  font-size: 22rpx;
  color: #cccccc;
  line-height: 1.4;
}

/* 历史进度 */
.history-section {
  padding: 0 24rpx 32rpx;
}

.history-chart {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
}

.chart-container {
  position: relative;
  height: 400rpx;
}

.chart-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  display: flex;
  align-items: center;
  height: 1rpx;
  background-color: #333333;
}

.grid-mark {
  margin-right: 16rpx;
  font-size: 16rpx;
  color: #999999;
  width: 40rpx;
  text-align: right;
}

.chart-data {
  position: absolute;
  left: 60rpx;
  top: 0;
  right: 24rpx;
  bottom: 0;
}

.data-point {
  position: absolute;
  transform: translate(-50%, -50%);
}

.point-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #D4B083;
  border: 2rpx solid #ffffff;
}

.point-label {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  color: #999999;
  white-space: nowrap;
}

.data-line {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* 操作按钮 */
.action-section {
  padding: 0 24rpx 32rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
}

.action-btn.primary {
  background-color: #D4B083;
  color: #000000;
}

.action-btn.secondary {
  background-color: #1a1a1a;
  color: #D4B083;
  border: 1rpx solid #D4B083;
}

.btn-text {
  font-size: 24rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .summary-value {
    font-size: 48rpx;
  }
  
  .chart-container {
    height: 300rpx;
  }
}
