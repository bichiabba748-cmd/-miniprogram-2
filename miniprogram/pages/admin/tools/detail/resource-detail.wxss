/* 资源使用详情页面样式 */

/* 全局样式 */
.detail-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #D4B083;
  font-weight: bold;
  white-space: nowrap;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx;
}

/* 资源概览 */
.overview-section {
  padding: 32rpx 24rpx;
}

.overview-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #333333;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #999999;
}

/* 文件类型分布 */
.file-types-section {
  padding: 0 24rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 24rpx;
}

.file-types-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.file-type-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.file-type-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background-color: #1a1a1a;
  border-radius: 12rpx;
}

.file-type-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.file-type-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}

.file-type-details {
  flex: 1;
}

.file-type-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.file-type-count {
  font-size: 20rpx;
  color: #999999;
}

.file-type-size {
  font-size: 20rpx;
  font-weight: 500;
  color: #D4B083;
}

/* 目录结构 */
.directory-section {
  padding: 0 24rpx 32rpx;
}

.directory-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.directory-tree {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.directory-item {
  padding: 8rpx 0;
}

.directory-level {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.directory-icon {
  font-size: 24rpx;
  width: 32rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 图标组件 */
.icon-folder::before {
  content: '📁';
}

.icon-file::before {
  content: '📄';
}

.directory-name {
  font-size: 20rpx;
  color: #ffffff;
  flex: 1;
}

.directory-count {
  font-size: 18rpx;
  color: #999999;
}

/* 资源趋势 */
.trend-section {
  padding: 0 24rpx 32rpx;
}

.trend-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.trend-chart {
  overflow-x: auto;
}

.chart-container {
  min-width: 100%;
}

.chart-header {
  display: flex;
  background-color: #1a1a1a;
  padding: 12rpx;
  border-radius: 8rpx 8rpx 0 0;
  font-size: 18rpx;
  font-weight: 500;
  color: #D4B083;
}

.chart-label {
  flex: 1;
  text-align: center;
}

.chart-body {
  border: 1rpx solid #333333;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  overflow: hidden;
}

.chart-row {
  display: flex;
  border-bottom: 1rpx solid #333333;
}

.chart-row:last-child {
  border-bottom: none;
}

.chart-cell {
  flex: 1;
  padding: 12rpx;
  text-align: center;
  font-size: 18rpx;
  color: #cccccc;
  background-color: #111111;
}

/* 云函数资源 */
.functions-section {
  padding: 0 24rpx 32rpx;
}

.functions-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.function-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.function-item {
  background-color: #1a1a1a;
  border-radius: 12rpx;
  padding: 20rpx;
}

.function-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.function-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.function-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.function-status.active {
  background-color: #52c41a;
  color: #000000;
}

.function-status.inactive {
  background-color: #ff4d4f;
  color: #ffffff;
}

.function-status.error {
  background-color: #faad14;
  color: #000000;
}

.function-details {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #333333;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 120rpx;
}

.detail-label {
  font-size: 18rpx;
  color: #999999;
}

.detail-value {
  font-size: 18rpx;
  font-weight: 500;
  color: #cccccc;
}

/* 优化建议 */
.optimization-section {
  padding: 0 24rpx 32rpx;
}

.optimization-card {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #333333;
}

.optimization-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.optimization-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #1a1a1a;
  border-radius: 12rpx;
}

.optimization-icon {
  font-size: 32rpx;
  margin-top: 4rpx;
}

.optimization-content {
  flex: 1;
  margin-right: 16rpx;
}

.optimization-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.optimization-desc {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.optimization-impact {
  font-size: 18rpx;
  color: #D4B083;
  font-weight: 500;
}

.optimization-action {
  padding: 12rpx 24rpx;
  background-color: #D4B083;
  color: #000000;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  align-self: center;
  cursor: pointer;
}

.action-text {
  font-size: 20rpx;
}

/* 操作按钮 */
.action-section {
  padding: 0 24rpx 32rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
}

.action-btn.primary {
  background-color: #D4B083;
  color: #000000;
}

.action-btn.secondary {
  background-color: #1a1a1a;
  color: #D4B083;
  border: 1rpx solid #D4B083;
}

.btn-text {
  font-size: 24rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .overview-stats {
    grid-template-columns: 1fr;
  }
  
  .stat-value {
    font-size: 36rpx;
  }
  
  .file-type-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 12rpx;
  }
  
  .file-type-size {
    align-self: flex-end;
  }
  
  .function-details {
    flex-direction: column;
  }
  
  .detail-item {
    min-width: 100%;
  }
  
  .optimization-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .optimization-action {
    align-self: flex-end;
    margin-top: 12rpx;
  }
  
  .action-section {
    flex-direction: column;
  }
}
