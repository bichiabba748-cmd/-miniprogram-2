/* 管理工具页面样式 */

/* 全局样式 */
.tools-container {
  background-color: #000000;
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #111111;
  border-bottom: 1rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4B083;
}

.nav-right {
  display: flex;
  align-items: center;
}

.help-btn {
  padding: 8rpx 20rpx;
  background-color: #D4B083;
  color: #000000;
  border: none;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 12rpx;
}

.refresh-btn {
  padding: 8rpx 20rpx;
  background-color: #1a1a1a;
  color: #D4B083;
  border: 1rpx solid #D4B083;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.btn-text {
  font-size: 24rpx;
}

/* 状态概览 */
.status-overview {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
}

.status-card {
  flex: 1;
  background-color: #111111;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #333333;
  text-align: center;
}

.status-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.status-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 8rpx;
}

.status-value.good {
  color: #07c160;
}

.status-value.warning {
  color: #faad14;
}

.status-value.error {
  color: #ff4d4f;
}

.status-desc {
  font-size: 20rpx;
  color: #D4B083;
}

/* 功能区 */
.function-section {
  margin: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #D4B083;
}

/* 功能卡片 */
.function-card {
  background-color: #111111;
  border-radius: 12rpx;
  border: 1rpx solid #333333;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #333333;
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #D4B083;
}

.card-action {
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  background-color: #1a1a1a;
  border: 1rpx solid #333333;
}

.action-text {
  font-size: 22rpx;
  color: #D4B083;
}

.card-content {
  padding: 24rpx;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #222222;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  border: 1rpx solid #333333;
}

.progress-fill {
  height: 100%;
  background-color: #D4B083;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #D4B083;
}

.info-text {
  font-size: 22rpx;
  color: #D4B083;
}

/* 健康指标 */
.health-indicators {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.indicator-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background-color: #1a1a1a;
  border-radius: 8rpx;
  border: 1rpx solid #333333;
  flex: 1;
  min-width: 160rpx;
}

.indicator-label {
  font-size: 22rpx;
  color: #D4B083;
}

.indicator-status {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #666666;
}

.indicator-status.good {
  background-color: #07c160;
}

.indicator-status.warning {
  background-color: #faad14;
}

.indicator-status.error {
  background-color: #ff4d4f;
}

.health-issues {
  margin-top: 16rpx;
}

.issues-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 12rpx;
}

.issues-list {
  background-color: rgba(255, 77, 79, 0.1);
  padding: 16rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.issue-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #ff4d4f;
  margin-bottom: 12rpx;
  line-height: 1.4;
  padding: 12rpx;
  background-color: rgba(255, 77, 79, 0.05);
  border-radius: 6rpx;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.issue-text {
  flex: 1;
  margin-right: 12rpx;
}

.issue-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.issue-action {
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.issue-action .action-text {
  font-size: 20rpx;
  color: #ff4d4f;
}

.issue-action.copy {
  background-color: rgba(212, 176, 131, 0.2);
  border: 1rpx solid rgba(212, 176, 131, 0.3);
}

.issue-action.copy .action-text {
  color: #D4B083;
}

.issue-action:hover {
  opacity: 0.8;
  transform: translateY(-1rpx);
}

.issue-item:last-child {
  margin-bottom: 0;
}

/* 备份信息 */
.backup-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.backup-history {
  margin-top: 0;
}

.history-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 12rpx;
}

.history-list {
  background-color: #1a1a1a;
  border-radius: 8rpx;
  border: 1rpx solid #333333;
  overflow: hidden;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  border-bottom: 1rpx solid #333333;
}

.history-item:last-child {
  border-bottom: none;
}

.history-time {
  font-size: 22rpx;
  color: #D4B083;
}

.history-size {
  font-size: 22rpx;
  color: #D4B083;
}

/* 资源统计 */
.resource-stats,
.function-stats,
.component-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: 140rpx;
  background-color: #1a1a1a;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #333333;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #D4B083;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4B083;
}

.stat-value.warning {
  color: #ff4d4f;
}

/* 操作引导 */
.guide-section {
  margin: 24rpx;
  margin-bottom: 48rpx;
}

.guide-card {
  background-color: #111111;
  border-radius: 12rpx;
  border: 1rpx solid #333333;
  padding: 24rpx;
}

.guide-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.guide-item:last-child {
  margin-bottom: 0;
}

.guide-number {
  width: 40rpx;
  height: 40rpx;
  background-color: #D4B083;
  color: #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.guide-content {
  flex: 1;
}

.guide-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #D4B083;
  margin-bottom: 8rpx;
}

.guide-desc {
  font-size: 22rpx;
  color: #D4B083;
  line-height: 1.4;
}

/* 加载覆盖层 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background-color: #111111;
  padding: 48rpx;
  border-radius: 12rpx;
  border: 1rpx solid #D4B083;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #333333;
  border-top: 4rpx solid #D4B083;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #D4B083;
}

/* 提示信息 */
.toast {
  position: fixed;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 32rpx;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  z-index: 9999;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  animation: fadeIn 0.3s ease, fadeOut 0.3s ease 2.7s;
}

.toast.success {
  background-color: #07c160;
}

.toast.error {
  background-color: #ff4d4f;
}

.toast.warning {
  background-color: #faad14;
}

.toast-info {
  background-color: #D4B083;
  color: #000000;
}

.toast-text {
  font-size: 24rpx;
}

/* 动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translate(-50%, -20rpx); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

@keyframes fadeOut {
  from { opacity: 1; transform: translate(-50%, 0); }
  to { opacity: 0; transform: translate(-50%, -20rpx); }
}

/* 测试按钮样式 */
.test-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.test-btn {
  background-color: #D4B083;
  color: #0a0a0a;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  font-weight: bold;
  font-size: 32rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.test-btn:hover {
  opacity: 0.9;
  transform: translateY(-2rpx);
}

.test-btn:active {
  transform: translateY(0);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .status-overview {
    flex-direction: column;
  }
  
  .status-card {
    width: 100%;
  }
  
  .health-indicators,
  .resource-stats,
  .function-stats,
  .component-stats {
    flex-direction: column;
  }
  
  .stat-item,
  .indicator-item {
    flex: none;
    width: 100%;
  }
}

/* 按钮样式 */
button {
  padding: 0;
  margin: 0;
  border: none;
  background: none;
  font-size: 24rpx;
}

button::after {
  border: none;
}

/* 大按钮样式 */
.large-action-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background-color: #D4B083;
  color: #000000;
  border-radius: 12rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.large-action-btn:hover {
  transform: scale(1.02);
  box-shadow: 0 4rpx 16rpx rgba(212, 176, 131, 0.3);
}