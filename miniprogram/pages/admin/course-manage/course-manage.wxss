page {
  background: #000;
  color: #fff;
  font-family: 'DIN', sans-serif;
}

.container {
  padding: 40rpx 30rpx;
  padding-bottom: 160rpx;
}

.header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 40rpx;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.header-line {
  width: 6rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #D4B083 0%, #E8D4B8 100%);
  border-radius: 3rpx;
  box-shadow: 0 0 20rpx rgba(212, 176, 131, 0.5);
}

.title {
  font-size: 48rpx;
  font-weight: 900;
  color: #D4B083;
  letter-spacing: 4rpx;
  text-shadow: 0 0 30rpx rgba(212, 176, 131, 0.3);
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.course-item {
  display: flex;
  background: #111;
  border: 1rpx solid #1a1a1a;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
  transition: all 0.3s ease;
}

.course-item:active {
  transform: scale(0.98);
  background: #161616;
}

.ci-cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.ci-image {
  width: 100%;
  height: 100%;
}

.ci-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ci-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.ci-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.ci-category {
  font-size: 22rpx;
  color: #D4B083;
  padding: 4rpx 12rpx;
  background: rgba(212, 176, 131, 0.1);
  border-radius: 6rpx;
  border: 1rpx solid rgba(212, 176, 131, 0.2);
}

.ci-duration {
  font-size: 22rpx;
  color: #666;
}

.ci-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ci-view {
  font-size: 22rpx;
  color: #666;
}

.ci-badge {
  font-size: 20rpx;
  color: #D4B083;
  padding: 4rpx 12rpx;
  background: rgba(212, 176, 131, 0.1);
  border-radius: 6rpx;
  border: 1rpx solid rgba(212, 176, 131, 0.2);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #D4B083 0%, #E8D4B8 100%);
  color: #0a0a0a;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.empty-btn::after {
  border: none;
}

.fab-btn {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #D4B083 0%, #E8D4B8 100%);
  color: #000;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 30rpx rgba(212, 176, 131, 0.4);
  z-index: 100;
  transition: all 0.3s ease;
}

.fab-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx rgba(212, 176, 131, 0.3);
}

.fab-icon {
  line-height: 1;
  margin-top: -6rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background: #111;
  border: 1rpx solid #1a1a1a;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #222;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.modal-close {
  font-size: 48rpx;
  color: #666;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  background: #0a0a0a;
  border: 1rpx solid #1a1a1a;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  padding: 24rpx;
  background: #0a0a0a;
  border: 1rpx solid #1a1a1a;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.time-inputs {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-input {
  flex: 1;
  padding: 24rpx;
  background: #0a0a0a;
  border: 1rpx solid #1a1a1a;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.time-separator {
  font-size: 32rpx;
  color: #666;
}

.cover-upload {
  width: 100%;
  height: 300rpx;
  background: #0a0a0a;
  border: 1rpx dashed #1a1a1a;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.3s ease;
}

.cover-upload:active {
  border-color: #D4B083;
  background: rgba(212, 176, 131, 0.05);
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.cover-icon {
  font-size: 80rpx;
  color: #666;
  line-height: 1;
}

.cover-text {
  font-size: 24rpx;
  color: #666;
}

.form-textarea {
  width: 100%;
  padding: 24rpx;
  background: #0a0a0a;
  border: 1rpx solid #1a1a1a;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  height: 200rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
  border-top: 1rpx solid #222;
}

.modal-btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.modal-btn.cancel {
  background: #222;
  color: #666;
}

.modal-btn.cancel::after {
  border: none;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #D4B083 0%, #E8D4B8 100%);
  color: #0a0a0a;
}

.modal-btn.confirm::after {
  border: none;
}
