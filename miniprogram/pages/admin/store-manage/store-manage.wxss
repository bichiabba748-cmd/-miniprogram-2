.container {
  padding: 32rpx;
  background-color: #0a0a0a;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4B083;
  display: block;
  margin-bottom: 10rpx;
  font-family: 'DIN Condensed Bold', 'PingFang SC', sans-serif;
}

.sub {
  font-size: 24rpx;
  color: #999;
  display: block;
  font-family: 'PingFang SC', sans-serif;
}

.search-bar {
  display: flex;
  margin-bottom: 24rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.search-input {
  flex: 1;
  height: 60rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
  background-color: transparent;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

.search-input::placeholder {
  color: #666;
}

.search-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #D4B083;
  color: #0a0a0a;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-family: 'PingFang SC', sans-serif;
}

.store-list {
  margin-bottom: 100rpx;
}

.store-item {
  display: flex;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10rpx);
}

.store-info {
  flex: 1;
}

.store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4B083;
  display: block;
  margin-bottom: 10rpx;
  font-family: 'DIN Condensed Bold', 'PingFang SC', sans-serif;
}

.store-code {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
  font-family: 'PingFang SC', sans-serif;
}

.store-address {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
  font-family: 'PingFang SC', sans-serif;
}

.store-manager {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
  font-family: 'PingFang SC', sans-serif;
}

.store-phone {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
  font-family: 'PingFang SC', sans-serif;
}

.store-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
  margin-top: 10rpx;
  font-family: 'PingFang SC', sans-serif;
}

.store-status.active {
  background-color: rgba(82, 196, 26, 0.2);
  color: #52c41a;
}

.store-status.inactive {
  background-color: rgba(255, 77, 79, 0.2);
  color: #ff4d4f;
}

.store-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
}

.action-btn {
  margin-bottom: 10rpx;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  font-family: 'PingFang SC', sans-serif;
}

.action-btn.edit {
  background-color: rgba(24, 144, 255, 0.2);
  color: #1890ff;
  border: 1rpx solid rgba(24, 144, 255, 0.5);
}

.action-btn.delete {
  background-color: rgba(255, 77, 79, 0.2);
  color: #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.5);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  margin-bottom: 100rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.empty-text {
  font-size: 32rpx;
  color: #D4B083;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.empty-tip {
  font-size: 24rpx;
  color: #666;
  font-family: 'PingFang SC', sans-serif;
}

.create-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #D4B083;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(212, 176, 131, 0.4);
  z-index: 999;
}

.create-btn-text {
  font-size: 48rpx;
  color: #0a0a0a;
  line-height: 80rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background-color: #1a1a1a;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(20rpx);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4B083;
  font-family: 'DIN Condensed Bold', 'PingFang SC', sans-serif;
}

.modal-close {
  font-size: 40rpx;
  color: #666;
  line-height: 40rpx;
}

.modal-body {
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 10rpx;
  font-family: 'PingFang SC', sans-serif;
}

.form-input {
  width: 100%;
  height: 60rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

.form-input::placeholder {
  color: #666;
}

.form-picker {
  width: 100%;
  height: 60rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 60rpx;
  background-color: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
  font-family: 'PingFang SC', sans-serif;
}

.modal-btn.cancel {
  background-color: rgba(255, 255, 255, 0.05);
  color: #999;
}

.modal-btn.confirm {
  background-color: #D4B083;
  color: #0a0a0a;
}
