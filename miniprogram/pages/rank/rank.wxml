<view class="container">
  <!-- 加载中状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-container" wx:elif="{{errorMsg}}">
    <view class="error-icon">⚠️</view>
    <text class="error-text">加载失败</text>
    <text class="error-detail">{{errorMsg}}</text>
    <view class="retry-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <!-- 正常内容区域 -->
  <block wx:else>
    <view class="rank-tabs" wx:if="{{isNewAnchor}}">
      <view class="tab {{activeTab === 'new' ? 'active' : ''}}" bindtap="switchTab" data-tab="new"><view class="tab-icon icon-sprout"></view> 新锐赛道</view>
      <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all"><view class="tab-icon icon-lion"></view> 全量战神</view>
    </view>
    <view class="rank-title-bar" wx:else>
      <view class="title-icon icon-lion"></view>
      <text>{{rankTitle}}</text>
    </view>

    <view class="podium">
    <view class="p-item rank-2" bindtap="goToUserScripts" data-name="{{top3[1].name}}">
      <view class="p-avatar-wrap">
        <image class="p-avatar" src="{{top3[1].avatar}}"></image>
        <view class="p-badge">2</view>
      </view>
      <text class="p-name">{{top3[1].name}}</text>
      <text class="p-val">{{top3[1][countField]}} {{countLabel}}</text>
    </view>
    <view class="p-item rank-1" bindtap="goToUserScripts" data-name="{{top3[0].name}}">
      <view class="p-avatar-wrap">
        <view class="crown icon-crown"></view>
        <image class="p-avatar" src="{{top3[0].avatar}}"></image>
        <view class="p-badge">1</view>
      </view>
      <text class="p-name">{{top3[0].name}}</text>
      <text class="p-val">{{top3[0][countField]}} {{countLabel}}</text>
    </view>
    <view class="p-item rank-3" bindtap="goToUserScripts" data-name="{{top3[2].name}}">
      <view class="p-avatar-wrap">
        <image class="p-avatar" src="{{top3[2].avatar}}"></image>
        <view class="p-badge">3</view>
      </view>
      <text class="p-name">{{top3[2].name}}</text>
      <text class="p-val">{{top3[2][countField]}} {{countLabel}}</text>
    </view>
  </view>

  <view class="rank-list" wx:if="{{canViewFull}}">
    <block wx:for="{{others}}" wx:key="id">
      <view class="list-item {{item.isMe ? 'is-me' : ''}}">
        <view class="r-num">
          <text wx:if="{{!item.isBottom}}">{{item.rank}}</text>
          <view wx:else class="refuel icon-gas"></view>
        </view>
        <image class="r-avatar" src="{{item.avatar}}"></image>
        <view class="r-info">
          <text class="r-name">{{item.name}}</text>
          <text class="r-store">{{item.store}}</text>
        </view>
        <view class="r-data">
          <text class="r-val">{{item[countField]}} {{countLabel}}</text>
          <view class="r-link" catchtap="goToUserScripts" data-name="{{item.name}}" wx:if="{{countField === 'leads'}}">
            {{item.scripts}} 篇 >
          </view>
        </view>
      </view>
    </block>
    
    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{hasMore && others.length > 0}}">
      <text class="load-more-text">上拉加载更多</text>
    </view>
    
    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && others.length > 0}}">
      <text class="no-more-text">已经到底了</text>
    </view>
    
    <!-- 空数据提示 - 只在非loading状态下显示 -->
    <view class="empty-state" wx:if="{{showEmpty && !loading}}">
      <text class="empty-text">暂无排行数据</text>
      <text class="empty-subtext" wx:if="{{countField === 'leads'}}">快去发布文案获取获客吧</text>
      <text class="empty-subtext" wx:if="{{countField === 'contracts'}}">快去签约提升排名吧</text>
      <text class="empty-subtext" wx:if="{{countField === 'showings'}}">快去做带看提升排名吧</text>
    </view>
  </view>
  
  <view class="limited-tip" wx:if="{{!canViewFull}}">
    <text class="tip-text">加入星火计划后，解锁全量战神榜</text>
    <view class="tip-btn" bindtap="goToJoin">立即加入</view>
  </view>
  </block>
</view>
