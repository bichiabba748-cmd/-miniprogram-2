page { background: #000; color: #fff; }
.container { padding: 0; padding-bottom: 60rpx; }

/* Tabs */
.rank-tabs { display: flex; background: #111; padding: 20rpx 60rpx; gap: 40rpx; border-bottom: 1rpx solid #222; }
.tab { font-size: 28rpx; color: #666; padding: 10rpx 0; position: relative; }
.tab.active { color: #D4B083; font-weight: bold; }
.tab.active::after { content: ''; position: absolute; bottom: -10rpx; left: 0; width: 100%; height: 4rpx; background: #D4B083; }
.rank-title-bar { padding: 40rpx; background: #111; border-bottom: 1rpx solid #222; }
.title-text { color: #D4B083; font-weight: 900; font-size: 32rpx; }

/* 颁奖台 */
.podium { display: flex; justify-content: center; align-items: flex-end; padding: 80rpx 0 60rpx; background: linear-gradient(to bottom, #111, #000); }
.p-item { display: flex; flex-direction: column; align-items: center; width: 30%; }
.p-avatar-wrap { position: relative; margin-bottom: 20rpx; }
.p-avatar { border-radius: 50%; border: 4rpx solid #333; background: #222; }
.rank-1 .p-avatar { width: 180rpx; height: 180rpx; border-color: #D4B083; box-shadow: 0 0 40rpx rgba(212,176,131,0.2); }
.rank-2 .p-avatar, .rank-3 .p-avatar { width: 130rpx; height: 130rpx; }
.rank-2 .p-avatar { border-color: #c0c0c0; }
.rank-3 .p-avatar { border-color: #cd7f32; }

.p-badge { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); background: #333; color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 20rpx; }
.rank-1 .p-badge { background: #D4B083; color: #000; }
.crown { position: absolute; top: -45rpx; left: 50%; transform: translateX(-50%); font-size: 44rpx; }
.p-name { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.p-val { font-size: 22rpx; color: #D4B083; }

/* 列表 */
.rank-list { padding: 0 20rpx; }
.list-item { display: flex; align-items: center; padding: 30rpx 20rpx; border-bottom: 1rpx solid #111; }
.is-me { background: rgba(212,176,131,0.05); border-radius: 12rpx; border: 1rpx solid rgba(212,176,131,0.1); }
.r-num { width: 60rpx; font-size: 32rpx; font-family: 'DIN'; color: #444; }
.refuel { font-size: 28rpx; }
.r-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; }
.r-info { flex: 1; }
.r-name { font-size: 28rpx; font-weight: bold; display: block; }
.r-store { font-size: 20rpx; color: #444; }
.r-data { text-align: right; }
.r-val { font-size: 28rpx; font-weight: bold; color: #eee; display: block; }
.r-link { font-size: 22rpx; color: #D4B083; margin-top: 6rpx; text-decoration: underline; }

/* 全局加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #333;
  border-top-color: #D4B083;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 30rpx;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}
.error-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}
.error-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}
.error-detail {
  font-size: 24rpx;
  color: #444;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
}
.retry-btn {
  background: #D4B083;
  color: #000;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-weight: bold;
}

/* 加载更多 */
.load-more { text-align: center; padding: 30rpx 0; }
.load-more-text { font-size: 24rpx; color: #666; }

/* 没有更多数据 */
.no-more { text-align: center; padding: 30rpx 0; }
.no-more-text { font-size: 24rpx; color: #444; }

/* 空数据提示 */
.empty-state { text-align: center; padding: 100rpx 40rpx; }
.empty-text { font-size: 32rpx; color: #666; display: block; margin-bottom: 20rpx; }
.empty-subtext { font-size: 24rpx; color: #444; }

/* 图标组件 - 使用文字替代emoji */
.icon-sprout::before {
  content: '新';
  color: #D4B083;
  font-weight: bold;
}

.icon-lion::before {
  content: '战';
  color: #D4B083;
  font-weight: bold;
}

.icon-crown::before {
  content: '冠';
  color: #D4B083;
  font-weight: bold;
}

.icon-gas::before {
  content: '油';
  color: #D4B083;
  font-weight: bold;
}

.tab-icon {
  display: inline-flex;
  align-items: center;
  margin-right: 8rpx;
}

.title-icon {
  display: inline-flex;
  align-items: center;
  margin-right: 8rpx;
}
