page { background: #000; color: #fff; height: 100vh; overflow: hidden; }
.container { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 20rpx 0 40rpx; }

.status-bar { padding: 0 40rpx; display: flex; justify-content: space-between; align-items: center; }
.region { display: flex; align-items: center; font-size: 24rpx; color: #444; }
.dot { width: 10rpx; height: 10rpx; background: #00ae66; border-radius: 50%; margin-right: 15rpx; box-shadow: 0 0 10rpx #00ae66; }

/* 放大看板核心样式：铺满左右，垂直加高 */
.header-zone { padding: 0 30rpx; margin-top: 20rpx; }
.board-card-anchor-full { 
  background: #0a0a0a; padding: 50rpx 40rpx; border-radius: 30rpx; 
  border: 1rpx solid #1a1a1a; display: flex; flex-direction: column; justify-content: center;
}
.b-title { font-size: 24rpx; color: #444; margin-bottom: 20rpx; }
.b-num-row { display: flex; justify-content: space-around; margin: 30rpx 0; }
.n-item .v { font-size: 64rpx; font-weight: 900; font-family: 'DIN'; display: block; }
.n-item .l { font-size: 20rpx; color: #333; margin-top: 10rpx; }
.submit-pill-full { background: #00ae66; font-size: 26rpx; font-weight: bold; padding: 24rpx 0; border-radius: 50rpx; text-align: center; }

/* 龙虎榜区域：填补空白 */
.rank-podium-section { 
  flex-grow: 1; display: flex; flex-direction: column; justify-content: center;
  margin: 30rpx 40rpx;
}
.rank-header { display: flex; justify-content: space-between; font-size: 24rpx; color: #444; margin-bottom: 30rpx; }
.podium-content { display: flex; justify-content: space-around; align-items: flex-end; }
.p-item { display: flex; flex-direction: column; align-items: center; }
.p-avatar-wrap { position: relative; margin-bottom: 15rpx; }
/* 头像回归大小 */
.p-avatar-wrap image { width: 110rpx; height: 110rpx; border-radius: 50%; border: 4rpx solid #1a1a1a; background: #111; }
.p1 .p-avatar-wrap image { width: 150rpx; height: 150rpx; border: 5rpx solid #ff9a00; }
.p-rank-num { position: absolute; bottom: 0; right: 0; width: 40rpx; height: 40rpx; background: #333; font-size: 22rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.p-rank-num.gold { background: #ff9a00; color: #000; font-weight: bold; }
.p-name { font-size: 24rpx; color: #888; margin-top: 10rpx; }
.p-data { font-size: 22rpx; color: #ff9a00; font-weight: bold; }

/* 底部功能组合 */
.bottom-zone { padding: 0 40rpx; }
.nav-grid { display: flex; justify-content: space-between; margin-bottom: 40rpx; }
.nav-icon { width: 100rpx; height: 100rpx; background: #111; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 44rpx; margin-bottom: 15rpx; border: 1rpx solid #1a1a1a; }
.live-report-bar { background: #080808; padding: 30rpx; border-radius: 16rpx; border: 1rpx solid #111; }
.report-swiper { height: 40rpx; }

/* 提报窗 */
.submit-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.submit-card { width: 85%; background: #111; padding: 50rpx; border-radius: 30rpx; position: relative; border: 1rpx solid #333; }
.card-close { position: absolute; top: 20rpx; right: 30rpx; font-size: 50rpx; color: #444; }
.f-item { margin-bottom: 30rpx; }
.f-item text { display: block; font-size: 22rpx; color: #666; margin-bottom: 10rpx; }
.f-item input { background: #000; height: 90rpx; border-radius: 15rpx; padding: 0 20rpx; border: 1rpx solid #222; }
.confirm-btn { background: #00ae66; margin-top: 40rpx; border-radius: 45rpx; font-weight: bold; }

/* 图标组件 */
.icon-note::before {
  content: '📝';
}

.icon-rocket::before {
  content: '🚀';
}

.icon-trophy::before {
  content: '🏆';
}

.icon-scroll::before {
  content: '📜';
}

.icon-video::before {
  content: '🎥';
}

.icon-lion::before {
  content: '🦁';
}